<view class="container">
  <view wx:if="{{loading}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">加载中...</view>
  </view>

  <block wx:else>
    <!-- Header -->
    <view class="flex-row" style="justify-content:space-between;align-items:flex-end;margin-bottom:32rpx;">
      <view>
        <view style="font-size:56rpx;font-weight:900;letter-spacing:4rpx;">九州</view>
        <view class="text-muted" style="font-size:22rpx;letter-spacing:6rpx;text-transform:uppercase;margin-top:4rpx;">Football Team</view>
      </view>
      <view wx:if="{{season}}" class="badge badge-gold">{{season}} Season</view>
    </view>

    <!-- Next Match Hero -->
    <view wx:if="{{nextMatch}}" class="hero-card" bindtap="goToMatch">
      <view style="font-size:22rpx;font-weight:900;color:#00C9A7;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">Next Match</view>
      <view style="font-size:40rpx;font-weight:900;color:#e8f0eb;line-height:1.2;">{{nextMatch.dateStr}}</view>
      <view class="text-muted" style="font-size:28rpx;margin-top:8rpx;">{{nextMatch.location}}</view>
      <view class="flex-row" style="justify-content:space-between;align-items:center;margin-top:32rpx;">
        <view class="badge {{nextMatch.statusBadge}}">{{nextMatch.statusLabel}}</view>
        <view style="font-size:28rpx;font-weight:900;color:#00C9A7;">报名 →</view>
      </view>
    </view>

    <view wx:else class="card" style="text-align:center;padding:48rpx 0;">
      <view class="text-muted">暂无即将进行的比赛</view>
    </view>

    <!-- Leaderboard entry -->
    <view class="card flex-row" style="justify-content:space-between;align-items:center;" bindtap="goLeaderboard">
      <view class="flex-row" style="gap:12rpx;align-items:center;">
        <view style="font-size:32rpx;">🏆</view>
        <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">射手榜 · 助攻榜</view>
      </view>
      <view style="color:#7A8FA6;font-size:32rpx;">›</view>
    </view>

    <!-- Announcements section label -->
    <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:20rpx;margin-top:8rpx;">公告</view>

    <view wx:if="{{announcements.length === 0}}" class="text-muted" style="font-size:28rpx;">暂无公告</view>

    <view wx:for="{{announcements}}" wx:key="id" class="card">
      <view class="flex-row" style="justify-content:space-between;align-items:flex-start;margin-bottom:12rpx;">
        <view style="font-size:30rpx;font-weight:700;flex:1;color:#e8f0eb;">{{item.title}}</view>
        <view wx:if="{{item.pinned}}" class="badge badge-gold" style="margin-left:16rpx;flex-shrink:0;">置顶</view>
      </view>
      <rich-text nodes="{{item.contentHtml}}" style="display:block;font-size:26rpx;line-height:1.7;"/>
    </view>
  </block>
</view>
