<view class="container" style="padding-bottom:40rpx;">

  <view wx:if="{{state === 'loading'}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">加载中...</view>
  </view>

  <view wx:elif="{{state === 'no-match'}}" class="card" style="text-align:center;padding:80rpx 0;margin-top:40rpx;">
    <view style="font-size:80rpx;">⚽</view>
    <view class="text-muted" style="margin-top:16rpx;">暂无进行中的比赛</view>
  </view>

  <view wx:elif="{{state === 'not-yet' || state === 'no-team'}}" class="card" style="text-align:center;padding:80rpx 0;margin-top:40rpx;">
    <view style="font-size:80rpx;">🔒</view>
    <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;margin-top:16rpx;">{{matchTitle}}</view>
    <view class="text-muted" style="margin-top:12rpx;font-size:24rpx;">{{lockMessage}}</view>
  </view>

  <block wx:elif="{{state === 'ok'}}">
    <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;margin-bottom:16rpx;">{{matchTitle}}</view>

    <view style="display:flex;flex-direction:row;align-items:center;gap:12rpx;background:rgba(240,180,41,0.1);border:1rpx solid rgba(240,180,41,0.3);border-radius:12rpx;padding:14rpx 20rpx;margin-bottom:16rpx;">
      <view style="font-size:26rpx;flex-shrink:0;">🤫</view>
      <view style="font-size:22rpx;color:#F0B429;line-height:1.5;">战术板仅本队可见，请勿截图或分享给对方队员</view>
    </view>

    <view class="pitch-wrap" style="width:{{pitchWidth}}px;height:{{pitchHeight}}px;">

      <view style="position:absolute;top:0;left:{{penX}}px;width:{{penW}}px;height:{{penH}}px;border:2rpx solid rgba(255,255,255,0.45);border-top:none;border-radius:0 0 6rpx 6rpx;"/>
      <view style="position:absolute;top:0;left:{{goalX}}px;width:{{goalW}}px;height:{{goalH}}px;border:2rpx solid rgba(255,255,255,0.45);border-top:none;"/>
      <view style="position:absolute;top:{{dotTopY}}px;left:{{dotX}}px;width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,0.5);"/>

      <view style="position:absolute;top:{{halfwayY}}px;left:0;width:100%;height:2rpx;background:rgba(255,255,255,0.45);"/>
      <view style="position:absolute;top:{{circleY}}px;left:{{circleX}}px;width:{{circleDiam}}px;height:{{circleDiam}}px;border-radius:50%;border:2rpx solid rgba(255,255,255,0.45);background:transparent;"/>
      <view style="position:absolute;top:{{halfwayY}}px;left:{{dotX}}px;width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,0.5);margin-top:-5px;"/>

      <view style="position:absolute;bottom:0;left:{{penX}}px;width:{{penW}}px;height:{{penH}}px;border:2rpx solid rgba(255,255,255,0.45);border-bottom:none;border-radius:6rpx 6rpx 0 0;"/>
      <view style="position:absolute;bottom:0;left:{{goalX}}px;width:{{goalW}}px;height:{{goalH}}px;border:2rpx solid rgba(255,255,255,0.45);border-bottom:none;"/>
      <view style="position:absolute;top:{{dotBotY}}px;left:{{dotX}}px;width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,0.5);"/>

      <movable-area style="position:absolute;top:0;left:0;width:{{pitchWidth}}px;height:{{pitchHeight}}px;background:transparent;">
        <movable-view
          wx:for="{{players}}"
          wx:key="uid"
          class="token-wrap"
          style="width:{{tokenPx}}px;height:{{tokenPx}}px;"
          x="{{item.x}}"
          y="{{item.y}}"
          direction="all"
          data-idx="{{index}}"
          bindchange="onMove"
          disabled="{{!canEdit}}">
          <view class="player-token {{item.team === 'A' ? 'token-a' : 'token-b'}} {{item.isMe ? 'token-me' : ''}}">
            <view class="token-initial">{{item.initial}}</view>
          </view>
          <view wx:if="{{item.position}}" class="position-tag">{{item.position}}</view>
          <view class="name-label">{{item.name}}{{item.isMe ? ' ★' : ''}}</view>
        </movable-view>
      </movable-area>
    </view>

    <view class="text-muted" style="font-size:22rpx;margin-top:16rpx;text-align:center;">
      ★ = 你的位置 · {{isCaptain ? '可拖动你方球员' : '仅查看，等待队长安排'}}
    </view>

    <button
      wx:if="{{canEdit}}"
      class="btn-primary"
      style="margin-top:24rpx;"
      bindtap="saveFormation">
      保存阵型
    </button>
  </block>
</view>
