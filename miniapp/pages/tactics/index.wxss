.pitch-wrap {
  position: relative;
  background: #2D7A2D;
  border: 3rpx solid #1E5C1E;
  border-radius: 12rpx;
  overflow: hidden;
}

/* movable-view wrapper — only the circle is the hit target; tags float outside */
.token-wrap {
  overflow: visible !important;
  background: transparent !important;
}

.player-token {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.token-a {
  background: linear-gradient(135deg, #00C9A7, #008B73);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.token-b {
  background: linear-gradient(135deg, #F0B429, #B58108);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.token-me {
  border-color: #ffffff !important;
  border-width: 3rpx !important;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.6), 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.token-initial {
  font-size: 22rpx;
  font-weight: 900;
  color: #0D1117;
  line-height: 1;
}

/* Position tag — floating to the right of the circle */
.position-tag {
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%);
  margin-left: 4rpx;
  background: rgba(11, 26, 16, 0.85);
  color: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  font-size: 16rpx;
  font-weight: 900;
  padding: 3rpx 6rpx;
  border-radius: 4rpx;
  line-height: 1;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

/* Name label — below the circle */
.name-label {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.1;
  white-space: nowrap;
  text-align: center;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.6);
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
