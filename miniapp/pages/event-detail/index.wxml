<view class="container">
  <view wx:if="{{isEntry}}" bindtap="goHome"
    style="display:flex;align-items:center;gap:8rpx;padding:20rpx 0 8rpx;color:#7A8FA6;font-size:26rpx;">
    <text style="font-size:30rpx;">‹</text><text>返回首页</text>
  </view>

  <view wx:if="{{loading}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">加载中...</view>
  </view>

  <view wx:elif="{{blocked}}" style="text-align:center;padding:100rpx 40rpx;">
    <view style="font-size:80rpx;">🔒</view>
    <view style="font-size:30rpx;font-weight:700;color:#e8f0eb;margin-top:24rpx;">{{blockedLabel}}</view>
    <view class="text-muted" style="font-size:24rpx;margin-top:12rpx;">如有疑问请联系管理员</view>
  </view>

  <view wx:elif="{{loadError}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted" style="margin-bottom:24rpx;">加载失败，请检查网络</view>
    <button class="btn-ghost" style="display:inline-block;" bindtap="retryLoad">重试</button>
  </view>

  <block wx:elif="{{event}}">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <view class="match-header">
      <view class="header-accent"></view>
      <view style="padding:32rpx;">
        <view style="font-size:36rpx;font-weight:900;color:#e8f0eb;line-height:1.3;">{{event.title}}</view>
        <view wx:if="{{event.eventDate || event.location}}" class="text-muted" style="font-size:26rpx;margin-top:8rpx;">{{eventDateStr}}<text wx:if="{{event.location}}"> · {{event.location}}</text></view>
        <view class="flex-row" style="gap:12rpx;flex-wrap:wrap;margin-top:20rpx;">
          <view class="badge {{event.status === 'prep' ? 'badge-gold' : event.status === 'open' ? 'badge-teal' : event.status === 'cancelled' ? 'badge-red' : 'badge-grey'}}">{{statusLabel}}</view>
          <view class="badge badge-grey">{{scopeLabel}}</view>
        </view>
        <view wx:if="{{deadlineStr && (event.status === 'prep' || event.status === 'open')}}" class="text-muted" style="font-size:22rpx;margin-top:16rpx;">⏳ 截止：{{deadlineStr}}</view>
      </view>
    </view>

    <!-- ── Admin phase bar ────────────────────────────────────────────── -->
    <view wx:if="{{isAdmin}}" class="card">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">阶段管理</view>
      <view class="flex-row" style="gap:12rpx;flex-wrap:wrap;">
        <view class="pick-tap pick-tap-a" bindtap="goResults">📊 实时结果</view>
        <view wx:if="{{event.status === 'draft' && hasPrep}}" class="pick-tap pick-tap-a" bindtap="setEvStatus" data-status="prep" data-label="开始第一轮">开始第一轮</view>
        <view wx:if="{{event.status === 'draft' || event.status === 'prep'}}" class="pick-tap pick-tap-a" bindtap="setEvStatus" data-status="open" data-label="开放{{actionLabel}}">开放{{actionLabel}}</view>
        <view wx:if="{{event.status === 'prep' || event.status === 'open'}}" class="pick-tap pick-tap-off" bindtap="setEvStatus" data-status="closed" data-label="结束">结束</view>
        <view wx:if="{{event.status !== 'cancelled'}}" class="pick-tap pick-tap-off" bindtap="setEvStatus" data-status="cancelled" data-label="取消">取消</view>
      </view>
      <view class="text-muted" style="font-size:22rpx;margin-top:12rpx;line-height:1.6;">{{event.status === 'draft' ? (hasPrep ? '草稿，只有管理员能看到。有第一轮问题就先「开始第一轮」，否则直接「开放' + actionLabel + '」' : '草稿，只有管理员能看到。点「开放' + actionLabel + '」就发出去了') : event.status === 'prep' ? '第一轮进行中：看下方结果 → 到「表单管理-编辑」定下方案 → 回来点「开放' + actionLabel + '」（会通知大家）' : event.status === 'open' ? '进行中：结果在下方实时汇总，到截止时间自动关闭，也可手动「结束」' : '已结束，内容已定格'}}</view>
    </view>

    <!-- ── Description ────────────────────────────────────────────────── -->
    <view wx:if="{{descriptionHtml}}" class="card">
      <rich-text nodes="{{descriptionHtml}}" style="display:block;font-size:26rpx;line-height:1.7;"/>
    </view>

    <!-- ── Not in scope ───────────────────────────────────────────────── -->
    <view wx:if="{{!inScope && (event.status === 'prep' || event.status === 'open')}}" class="action-card action-neutral">
      <view style="font-size:28rpx;font-weight:700;">本表单{{scopeLabel}}参与</view>
      <view class="text-muted" style="font-size:24rpx;margin-top:8rpx;">如有疑问请联系管理员</view>
    </view>

    <!-- ── Round one ──────────────────────────────────────────────────── -->
    <block wx:if="{{event.status === 'prep' && inScope}}">
      <view class="card">
        <view style="font-size:22rpx;font-weight:900;color:#F0B429;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:8rpx;">第一轮</view>
        <view class="text-muted" style="font-size:24rpx;margin-bottom:20rpx;">先答这轮不算{{actionLabel}}——方案定下来后会再开放正式{{actionLabel}}（{{prepCount}} 人已答）</view>
        <view wx:for="{{prepVM}}" wx:key="id" wx:for-item="q" style="margin-bottom:24rpx;">
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;margin-bottom:12rpx;">{{q.title}}<text wx:if="{{q.required}}" style="color:#E53E3E;"> *</text><text wx:if="{{q.type === 'multi'}}" class="text-muted" style="font-size:22rpx;font-weight:400;">（可多选）</text></view>

          <input wx:if="{{q.type === 'text'}}" class="ev-input" value="{{q.textValue}}" placeholder="填写..."
            bindinput="onAnswerText" data-round="prep" data-qid="{{q.id}}" adjust-position="{{false}}"/>

          <view wx:elif="{{q.type === 'number'}}" class="flex-row" style="align-items:center;gap:16rpx;">
            <view class="pick-tap pick-tap-off" bindtap="onAnswerNumber" data-round="prep" data-qid="{{q.id}}" data-delta="-1" data-max="{{q.max}}">−</view>
            <view style="font-size:32rpx;font-weight:900;color:#e8f0eb;min-width:48rpx;text-align:center;">{{q.numValue}}</view>
            <view class="pick-tap pick-tap-off" bindtap="onAnswerNumber" data-round="prep" data-qid="{{q.id}}" data-delta="1" data-max="{{q.max}}">+</view>
            <view class="text-muted" style="font-size:22rpx;">最多 {{q.max}}</view>
          </view>

          <view wx:else style="display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx;">
            <view wx:for="{{q.opts}}" wx:key="label" wx:for-item="o"
              class="ev-opt {{o.selected ? 'active' : ''}}"
              bindtap="pickOption" data-round="prep" data-qid="{{q.id}}" data-opt="{{o.label}}" data-qtype="{{q.type}}">
              {{o.label}}<text wx:if="{{o.count > -1}}" class="ev-opt-count">{{o.count}}票</text>
            </view>
          </view>
        </view>
        <button class="btn-primary" bindtap="submitPrep" disabled="{{busy}}">{{myStatus ? '更新' : '提交'}}</button>
      </view>
    </block>

    <!-- ── Main round ─────────────────────────────────────────────────── -->
    <block wx:if="{{event.status === 'open' && inScope}}">
      <view wx:if="{{prepVM.length > 0}}" class="card">
        <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">第一轮结果（{{prepCount}} 人参与）</view>
        <view wx:for="{{prepVM}}" wx:key="id" wx:for-item="q" style="margin-bottom:16rpx;">
          <view class="text-muted" style="font-size:24rpx;margin-bottom:8rpx;">{{q.title}}</view>
          <view style="display:flex;flex-direction:row;flex-wrap:wrap;gap:10rpx;">
            <view wx:for="{{q.opts}}" wx:key="label" wx:for-item="o" class="ev-opt" style="pointer-events:none;">{{o.label}}<text class="ev-opt-count">{{o.count}}票</text></view>
          </view>
        </view>
      </view>

      <view class="card">
        <view style="font-size:22rpx;font-weight:900;color:#00C9A7;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">{{myStatus === 'submitted' ? '我的回答（可修改）' : actionLabel}}</view>

        <view wx:for="{{mainVM}}" wx:key="id" wx:for-item="q" style="margin-bottom:24rpx;">
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;margin-bottom:12rpx;">{{q.title}}<text wx:if="{{q.required}}" style="color:#E53E3E;"> *</text><text wx:if="{{q.type === 'multi'}}" class="text-muted" style="font-size:22rpx;font-weight:400;">（可多选）</text><text wx:if="{{q.exclusive}}" style="font-size:22rpx;font-weight:400;color:#F0B429;"> · 先到先得</text></view>
          <view wx:if="{{q.exclusive}}" class="text-muted" style="font-size:22rpx;margin-bottom:12rpx;">灰掉的已经被人选走了，选不了</view>

          <input wx:if="{{q.type === 'text'}}" class="ev-input" value="{{q.textValue}}" placeholder="填写..."
            bindinput="onAnswerText" data-round="main" data-qid="{{q.id}}" adjust-position="{{false}}"/>

          <view wx:elif="{{q.type === 'number'}}" class="flex-row" style="align-items:center;gap:16rpx;">
            <view class="pick-tap pick-tap-off" bindtap="onAnswerNumber" data-round="main" data-qid="{{q.id}}" data-delta="-1" data-max="{{q.max}}">−</view>
            <view style="font-size:32rpx;font-weight:900;color:#e8f0eb;min-width:48rpx;text-align:center;">{{q.numValue}}</view>
            <view class="pick-tap pick-tap-off" bindtap="onAnswerNumber" data-round="main" data-qid="{{q.id}}" data-delta="1" data-max="{{q.max}}">+</view>
            <view class="text-muted" style="font-size:22rpx;">最多 {{q.max}}</view>
          </view>

          <view wx:else style="display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx;">
            <view wx:for="{{q.opts}}" wx:key="label" wx:for-item="o"
              class="ev-opt {{o.selected ? 'active' : ''}} {{o.locked ? 'taken' : ''}}"
              bindtap="pickOption" data-round="main" data-qid="{{q.id}}" data-opt="{{o.label}}" data-qtype="{{q.type}}" data-takenby="{{o.locked ? o.takenBy : ''}}">
              {{o.label}}<text wx:if="{{o.count > -1}}" class="ev-opt-count">{{o.count}}</text><text wx:elif="{{o.takenBy}}" class="ev-opt-count">{{o.takenBy}}</text>
            </view>
          </view>
        </view>

        <button class="btn-primary" bindtap="submitMain" disabled="{{busy}}">{{myStatus === 'submitted' ? '保存修改' : actionLabel}}</button>
        <button wx:if="{{myStatus === 'submitted'}}" class="btn-ghost btn-danger" style="margin-top:16rpx;" bindtap="withdrawEvent" disabled="{{busy}}">撤回</button>
      </view>
    </block>

    <!-- ── Who answered ───────────────────────────────────────────────── -->
    <view wx:if="{{showRoster}}" class="card" style="padding-bottom:8rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">
        已{{actionLabel}} {{submittedCount}} 人<text wx:if="{{headcount > submittedCount}}" style="color:#00C9A7;"> · 总人数 {{headcount}}</text>
      </view>
      <view wx:for="{{roster}}" wx:key="uid" class="player-row">
        <view style="width:40rpx;text-align:center;font-size:22rpx;font-weight:900;color:#3A4E63;flex-shrink:0;">{{index + 1}}</view>
        <view style="flex:1;margin-left:16rpx;font-size:28rpx;color:#e8f0eb;">
          {{item.displayName}}<text wx:if="{{item.seats > 0}}" class="text-muted" style="font-size:22rpx;"> +{{item.seats}}</text>
        </view>
      </view>
    </view>

    <view wx:elif="{{showCount && submittedCount > 0}}" class="card">
      <view class="text-muted" style="font-size:24rpx;text-align:center;">已有 {{submittedCount}} 人{{actionLabel}}<text wx:if="{{headcount > submittedCount}}"> · 总人数 {{headcount}}</text></view>
    </view>

  </block>
</view>
