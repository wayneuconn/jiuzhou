<view class="container">
  <view wx:if="{{isEntry}}" bindtap="goHome"
    style="display:flex;align-items:center;gap:8rpx;padding:20rpx 0 8rpx;color:#7A8FA6;font-size:26rpx;">
    <text style="font-size:30rpx;">‹</text><text>返回首页</text>
  </view>

  <view wx:if="{{loading}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">加载中...</view>
  </view>

  <view wx:elif="{{blocked}}" style="text-align:center;padding:100rpx 40rpx;">
    <view style="font-size:80rpx;">🔒</view>
    <view style="font-size:30rpx;font-weight:700;color:#e8f0eb;margin-top:24rpx;">{{blockedLabel}}</view>
    <view class="text-muted" style="font-size:24rpx;margin-top:12rpx;">如有疑问请联系管理员</view>
  </view>

  <view wx:elif="{{loadError}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted" style="margin-bottom:24rpx;">加载失败，请检查网络</view>
    <button class="btn-ghost" style="display:inline-block;" bindtap="retryLoad">重试</button>
  </view>

  <block wx:elif="{{event}}">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <view class="match-header">
      <view class="header-accent"></view>
      <view style="padding:32rpx;">
        <view style="font-size:22rpx;font-weight:900;color:#F0B429;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:12rpx;">🎉 球队活动</view>
        <view style="font-size:36rpx;font-weight:900;color:#e8f0eb;line-height:1.3;">{{event.title}}</view>
        <view class="text-muted" style="font-size:26rpx;margin-top:8rpx;">{{eventDateStr}}<text wx:if="{{event.location}}"> · {{event.location}}</text></view>
        <view class="flex-row" style="gap:12rpx;flex-wrap:wrap;margin-top:20rpx;">
          <view class="badge {{event.status === 'polling' ? 'badge-gold' : event.status === 'registration' ? 'badge-teal' : event.status === 'cancelled' ? 'badge-red' : 'badge-grey'}}">{{statusLabel}}</view>
          <view class="badge badge-grey">{{scopeLabel}}</view>
          <view wx:if="{{event.allowGuests}}" class="badge badge-grey">可带家属 ≤{{event.maxGuestsPer}}</view>
        </view>
        <view wx:if="{{deadlineStr && (event.status === 'polling' || event.status === 'registration')}}" class="text-muted" style="font-size:22rpx;margin-top:16rpx;">⏳ 报名截止：{{deadlineStr}}</view>
      </view>
    </view>

    <!-- ── Admin phase bar ────────────────────────────────────────────── -->
    <view wx:if="{{isAdmin}}" class="card">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">阶段管理</view>
      <view class="flex-row" style="gap:12rpx;flex-wrap:wrap;">
        <view class="pick-tap pick-tap-a" bindtap="goResults">📊 实时结果</view>
        <view wx:if="{{event.status === 'draft' && event.pollQuestions.length > 0}}" class="pick-tap pick-tap-a" bindtap="setEvStatus" data-status="polling" data-label="开始征集意见">开始投票</view>
        <view wx:if="{{event.status === 'draft' || event.status === 'polling'}}" class="pick-tap pick-tap-a" bindtap="setEvStatus" data-status="registration" data-label="开放报名">开放报名</view>
        <view wx:if="{{event.status === 'polling' || event.status === 'registration'}}" class="pick-tap pick-tap-off" bindtap="setEvStatus" data-status="closed" data-label="截止关闭">关闭</view>
        <view wx:if="{{event.status !== 'cancelled'}}" class="pick-tap pick-tap-off" bindtap="setEvStatus" data-status="cancelled" data-label="取消活动">取消活动</view>
      </view>
      <view class="text-muted" style="font-size:22rpx;margin-top:12rpx;line-height:1.6;">{{event.status === 'draft' ? '现在是草稿，只有管理员能看到。有投票题就先「开始投票」征集意见；简单活动直接「开放报名」' : event.status === 'polling' ? '征集中：看下方票数 → 到「活动管理-编辑」定下最终时间 → 回来点「开放报名」（会通知大家）' : event.status === 'registration' ? '报名中：名单和人数在下方实时汇总，到截止时间自动关闭，也可手动「关闭」' : '活动已结束，名单已定格'}}</view>
    </view>

    <!-- ── Description ────────────────────────────────────────────────── -->
    <view wx:if="{{descriptionHtml}}" class="card">
      <rich-text nodes="{{descriptionHtml}}" style="display:block;font-size:26rpx;line-height:1.7;"/>
    </view>

    <!-- ── Not in scope ───────────────────────────────────────────────── -->
    <view wx:if="{{!inScope && (event.status === 'polling' || event.status === 'registration')}}" class="action-card action-neutral">
      <view style="font-size:28rpx;font-weight:700;">本活动{{scopeLabel}}参加</view>
      <view class="text-muted" style="font-size:24rpx;margin-top:8rpx;">如有疑问请联系管理员</view>
    </view>

    <!-- ── Polling phase ──────────────────────────────────────────────── -->
    <block wx:if="{{event.status === 'polling' && inScope}}">
      <view class="card">
        <view style="font-size:22rpx;font-weight:900;color:#F0B429;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:8rpx;">征集意见</view>
        <view class="text-muted" style="font-size:24rpx;margin-bottom:20rpx;">先投票不算报名——时间定下来后会再开放正式报名（{{pollCount}} 人已投）</view>
        <view wx:for="{{pollVM}}" wx:key="id" wx:for-item="q" style="margin-bottom:24rpx;">
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;margin-bottom:12rpx;">{{q.title}}<text wx:if="{{q.required}}" style="color:#E53E3E;"> *</text><text wx:if="{{q.type === 'multi'}}" class="text-muted" style="font-size:22rpx;font-weight:400;">（可多选）</text></view>
          <input wx:if="{{q.type === 'text'}}" class="ev-input" value="{{q.textValue}}" placeholder="填写..."
            bindinput="onAnswerText" data-phase="poll" data-qid="{{q.id}}" adjust-position="{{false}}"/>
          <view wx:else style="display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx;">
            <view wx:for="{{q.opts}}" wx:key="label" wx:for-item="o"
              class="ev-opt {{o.selected ? 'active' : ''}}"
              bindtap="pickOption" data-phase="poll" data-qid="{{q.id}}" data-opt="{{o.label}}" data-qtype="{{q.type}}">
              {{o.label}}<text wx:if="{{o.count > -1}}" class="ev-opt-count">{{o.count}}票</text>
            </view>
          </view>
        </view>
        <button class="btn-primary" bindtap="submitPoll" disabled="{{busy}}">{{myStatus ? '更新投票' : '提交投票'}}</button>
      </view>
    </block>

    <!-- ── Registration phase ─────────────────────────────────────────── -->
    <block wx:if="{{event.status === 'registration' && inScope}}">
      <!-- poll results recap -->
      <view wx:if="{{pollVM.length > 0}}" class="card">
        <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">投票结果（{{pollCount}} 人参与）</view>
        <view wx:for="{{pollVM}}" wx:key="id" wx:for-item="q" style="margin-bottom:16rpx;">
          <view class="text-muted" style="font-size:24rpx;margin-bottom:8rpx;">{{q.title}}</view>
          <view style="display:flex;flex-direction:row;flex-wrap:wrap;gap:10rpx;">
            <view wx:for="{{q.opts}}" wx:key="label" wx:for-item="o" class="ev-opt" style="pointer-events:none;">{{o.label}}<text class="ev-opt-count">{{o.count}}票</text></view>
          </view>
        </view>
      </view>

      <view class="card">
        <view style="font-size:22rpx;font-weight:900;color:#00C9A7;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">{{myStatus === 'confirmed' ? '我的报名（可修改）' : '报名参加'}}</view>

        <block wx:if="{{event.allowGuests}}">
          <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:12rpx;">
            <view style="font-size:28rpx;color:#e8f0eb;">带家属/朋友</view>
            <view class="flex-row" style="align-items:center;gap:16rpx;">
              <view class="pick-tap pick-tap-off" bindtap="incGuests" data-delta="-1">−</view>
              <view style="font-size:32rpx;font-weight:900;color:#e8f0eb;min-width:40rpx;text-align:center;">{{guests}}</view>
              <view class="pick-tap pick-tap-off" bindtap="incGuests" data-delta="1">+</view>
            </view>
          </view>
          <input wx:if="{{guests > 0}}" class="ev-input" style="margin-bottom:20rpx;" value="{{guestNames}}"
            placeholder="家属称呼（选填，如：夫人+娃）" bindinput="onGuestNames" adjust-position="{{false}}"/>
        </block>

        <view wx:for="{{signupVM}}" wx:key="id" wx:for-item="q" style="margin-bottom:24rpx;">
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;margin-bottom:12rpx;">{{q.title}}<text wx:if="{{q.required}}" style="color:#E53E3E;"> *</text><text wx:if="{{q.type === 'multi'}}" class="text-muted" style="font-size:22rpx;font-weight:400;">（可多选）</text></view>
          <input wx:if="{{q.type === 'text'}}" class="ev-input" value="{{q.textValue}}" placeholder="填写..."
            bindinput="onAnswerText" data-phase="signup" data-qid="{{q.id}}" adjust-position="{{false}}"/>
          <view wx:else style="display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx;">
            <view wx:for="{{q.opts}}" wx:key="label" wx:for-item="o"
              class="ev-opt {{o.selected ? 'active' : ''}}"
              bindtap="pickOption" data-phase="signup" data-qid="{{q.id}}" data-opt="{{o.label}}" data-qtype="{{q.type}}">
              {{o.label}}<text wx:if="{{o.count > -1}}" class="ev-opt-count">{{o.count}}</text>
            </view>
          </view>
        </view>

        <button class="btn-primary" bindtap="submitSignup" disabled="{{busy}}">{{myStatus === 'confirmed' ? '保存修改' : '确认报名'}}</button>
        <button wx:if="{{myStatus === 'confirmed'}}" class="btn-ghost btn-danger" style="margin-top:16rpx;" bindtap="withdrawEvent" disabled="{{busy}}">取消报名</button>
      </view>
    </block>

    <!-- ── Attendees ──────────────────────────────────────────────────── -->
    <view wx:if="{{attendees.length > 0}}" class="card" style="padding-bottom:8rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">
        已报名 {{attendees.length}} 人<text wx:if="{{headcount > attendees.length}}" style="color:#00C9A7;"> · 总人数 {{headcount}}（含家属）</text>
      </view>
      <view wx:for="{{attendees}}" wx:key="uid" class="player-row">
        <view style="width:40rpx;text-align:center;font-size:22rpx;font-weight:900;color:#3A4E63;flex-shrink:0;">{{index + 1}}</view>
        <view style="flex:1;margin-left:16rpx;font-size:28rpx;color:#e8f0eb;">
          {{item.displayName}}<text wx:if="{{item.guests > 0}}" class="text-muted" style="font-size:22rpx;"> +{{item.guests}}{{item.guestNames ? '（' + item.guestNames + '）' : ''}}</text>
        </view>
      </view>
    </view>

  </block>
</view>
