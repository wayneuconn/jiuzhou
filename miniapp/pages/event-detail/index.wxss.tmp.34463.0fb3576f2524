.match-header {
  background: linear-gradient(180deg, #1A2535, #0F1923);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  position: relative;
}

.header-accent {
  height: 6rpx;
  background: linear-gradient(90deg, #F0B429, #00C9A7);
}

.ev-input {
  background: #1A2535;
  border: 1rpx solid #1E2D3D;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 88rpx;
  font-size: 28rpx;
  color: #e8f0eb;
  width: 100%;
  box-sizing: border-box;
}

.ev-opt {
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: 1rpx solid #1E2D3D;
  color: #7A8FA6;
}

.ev-opt.active {
  background: #00C9A7;
  color: #0D1117;
  border-color: #00C9A7;
}

.ev-opt-count {
  font-size: 20rpx;
  margin-left: 8rpx;
  opacity: 0.75;
}

.pick-tap {
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-block;
}

.pick-tap-a { background: rgba(0,201,167,0.12); color: #00C9A7; border: 1rpx solid rgba(0,201,167,0.35); }
.pick-tap-off { background: transparent; color: #7A8FA6; border: 1rpx solid #1E2D3D; }

.action-card {
  background: #131F2E;
  border: 1rpx solid #1E2D3D;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.action-neutral { border-color: #1E2D3D; }

.player-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #1E2D3D;
}

.player-row:last-child { border-bottom: none; }
