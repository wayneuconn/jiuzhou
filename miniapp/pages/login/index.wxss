.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 60rpx;
  background: #0D1117;
}

.logo {
  font-size: 120rpx;
  font-weight: 900;
  color: #00C9A7;
  letter-spacing: 12rpx;
}

.tagline {
  font-size: 26rpx;
  color: #7A8FA6;
  margin-top: 16rpx;
  margin-bottom: 120rpx;
  letter-spacing: 2rpx;
}

.login-btn {
  width: 100%;
}
