.pos-filter-btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 900;
  border: 1rpx solid #1E2D3D;
  color: #7A8FA6;
  margin-right: 12rpx;
  margin-bottom: 4rpx;
}

.pos-filter-btn.active {
  background: #00C9A7;
  color: #0D1117;
  border-color: #00C9A7;
}

.player-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #1E2D3D;
}

.player-row:last-child {
  border-bottom: none;
}

/* ── Period switch (月榜/年榜/总榜) ─────────────────────────────────────── */
.period-switch {
  background: #1A2535;
  border-radius: 12rpx;
  padding: 4rpx;
}

.period-btn {
  padding: 8rpx 22rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #7A8FA6;
}

.period-btn.active {
  background: #00C9A7;
  color: #0D1117;
}

/* Guests share one leaderboard row per name — flag them so a repeated
   nickname isn't mistaken for a regular member. */
.guest-tag {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #7A8FA6;
  border: 1rpx solid rgba(122, 143, 166, 0.4);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  line-height: 1.4;
}
