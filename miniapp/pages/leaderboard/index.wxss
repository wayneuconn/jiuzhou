.pos-filter-btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 900;
  border: 1rpx solid #1E2D3D;
  color: #7A8FA6;
  margin-right: 12rpx;
  margin-bottom: 4rpx;
}

.pos-filter-btn.active {
  background: #00C9A7;
  color: #0D1117;
  border-color: #00C9A7;
}

.player-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #1E2D3D;
}

.player-row:last-child {
  border-bottom: none;
}
