<view class="container">
  <view wx:if="{{loading}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">加载中...</view>
  </view>

  <!-- Visitor view: a real page, not a gate. Everything here reads without an
       identity, and 完善资料 is one optional card among several. -->
  <block wx:elif="{{needSetup}}">
    <view style="font-size:48rpx;font-weight:900;margin-bottom:24rpx;">我的</view>

    <view class="card" style="text-align:center;padding:40rpx 32rpx;">
      <view style="font-size:64rpx;">⚽</view>
      <view style="font-size:30rpx;font-weight:900;color:#e8f0eb;margin-top:16rpx;">欢迎来到九州</view>
      <view class="text-muted" style="font-size:25rpx;margin-top:12rpx;line-height:1.7;">
        浏览比赛、公告、战术板和榜单都不需要登记资料。想报名比赛、或者查看自己的出勤和进球数据，再填昵称和擅长位置就行。
      </view>
      <view class="flex-row" style="gap:16rpx;margin-top:28rpx;">
        <button class="btn-primary" style="flex:1;" bindtap="goSetup">完善资料</button>
        <button class="btn-ghost" style="flex:1;" bindtap="goBrowse">先逛逛</button>
      </view>
    </view>

    <view class="card" style="margin-top:16rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:20rpx;">会员身份说明</view>
      <view class="flex-row" style="align-items:flex-start;gap:16rpx;margin-bottom:16rpx;">
        <view class="badge badge-teal" style="flex-shrink:0;">年卡</view>
        <view class="text-muted" style="font-size:24rpx;line-height:1.6;flex:1;">R1 轮优先报名，并且可以带朋友（每人最多 2 位）</view>
      </view>
      <view class="flex-row" style="align-items:flex-start;gap:16rpx;margin-bottom:16rpx;">
        <view class="badge badge-gold" style="flex-shrink:0;">次卡</view>
        <view class="text-muted" style="font-size:24rpx;line-height:1.6;flex:1;">R1 轮可先加入候补，R2 轮开放后正常报名</view>
      </view>
      <view class="flex-row" style="align-items:flex-start;gap:16rpx;">
        <view class="badge badge-grey" style="flex-shrink:0;">未激活</view>
        <view class="text-muted" style="font-size:24rpx;line-height:1.6;flex:1;">新朋友的初始状态，联系管理员开通后即可自己报名</view>
      </view>
    </view>

    <view class="card" style="margin-top:16rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">联系管理员</view>
      <view class="contact-card">
        <view class="contact-name">{{adminContact.name}}</view>
        <view class="text-muted" style="font-size:23rpx;margin-top:8rpx;line-height:1.6;">开通会员、帮忙代报名、比赛安排，都可以找他</view>
      </view>
    </view>
  </block>

  <view wx:elif="{{loadError}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted" style="margin-bottom:24rpx;">加载失败，请检查网络</view>
    <button class="btn-ghost" style="display:inline-block;" bindtap="retryLoad">重试</button>
  </view>

  <block wx:elif="{{user}}">

    <!-- Player card -->
    <view class="player-card" style="border-color:{{tierColor}};">
      <view class="flex-row" style="justify-content:space-between;margin-bottom:24rpx;">
        <view class="flex-row" style="gap:8rpx;align-items:flex-end;">
          <view style="font-size:32rpx;font-weight:900;color:#e8f0eb;">{{user.attendanceCount}}</view>
          <view class="text-muted" style="font-size:22rpx;margin-bottom:2rpx;">场</view>
        </view>
        <view wx:if="{{hasNextTier}}" style="font-size:22rpx;font-weight:700;color:{{tierColor}};">再 {{nextTierGamesLeft}} 场 →</view>
      </view>
      <view style="text-align:center;">
        <view class="avatar-circle-large" style="border-color:{{tierColor}};">
          <text style="font-size:48rpx;font-weight:900;color:{{tierColor}};">{{user.displayName[0]}}</text>
        </view>
        <view style="font-size:36rpx;font-weight:900;margin-top:16rpx;color:#e8f0eb;">{{user.displayName}}</view>
        <view wx:if="{{priorityPositions.length > 0}}" style="display:flex;flex-direction:row;justify-content:center;gap:12rpx;margin-top:12rpx;flex-wrap:wrap;">
          <view wx:for="{{priorityPositions}}" wx:key="pos"
            class="pos-chip {{index === 0 ? 'pos-chip-primary' : 'pos-chip-secondary'}}">{{item.pos}}</view>
        </view>
      </view>
    </view>

    <!-- Badges row -->
    <view class="flex-row" style="gap:12rpx;flex-wrap:wrap;margin-bottom:20rpx;">
      <view class="badge {{membershipBadge}}">{{membershipLabel}}</view>
      <view wx:if="{{tierLabel}}" class="badge" style="color:{{tierColor}};border-color:{{tierColor}};">{{tierLabel}}</view>
      <view wx:if="{{user.role === 'admin'}}" class="badge badge-gold">管理员</view>
    </view>

    <!-- 赛季确认书：未确认会拦住报名，所以放在最前面 -->
    <view wx:if="{{seasonWaiver}}" class="card" style="margin-bottom:16rpx;border:1rpx solid {{seasonWaiver.signed ? 'rgba(0,201,167,0.35)' : 'rgba(229,62,62,0.45)'}};">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:12rpx;">{{seasonWaiver.season}} 赛季参与须知</view>
      <view style="font-size:30rpx;font-weight:900;color:#e8f0eb;">{{seasonWaiver.title}}</view>

      <block wx:if="{{seasonWaiver.signed}}">
        <view style="font-size:26rpx;color:#00C9A7;font-weight:700;margin-top:16rpx;">✓ 本赛季已确认</view>
        <view class="text-muted" style="font-size:22rpx;margin-top:6rpx;">每赛季确认一次；内容更新时会再提醒你</view>
        <button class="inline-btn" style="margin-top:16rpx;" bindtap="openWaiverModal">再看一遍</button>
      </block>

      <block wx:else>
        <view class="text-muted" style="font-size:24rpx;margin-top:12rpx;line-height:1.6;">
          <text wx:if="{{seasonWaiver.required}}" style="color:#FF8A8A;">未确认前无法报名比赛。</text>请阅读全文后填写真实姓名确认知悉。
        </view>
        <button class="btn-primary" style="margin-top:20rpx;" bindtap="openWaiverModal">阅读并确认</button>
      </block>
    </view>

    <!-- 赛季年卡登记 (current 年卡 holders only; no tallies shown) -->
    <view wx:if="{{seasonDrive}}" class="card" style="border:1rpx solid rgba(0,201,167,0.4);margin-bottom:16rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#00C9A7;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:12rpx;">赛季年卡登记</view>
      <view style="font-size:30rpx;font-weight:900;color:#e8f0eb;">{{seasonDrive.season}} 赛季</view>
      <view wx:if="{{renewalDeadlineStr}}" class="text-muted" style="font-size:22rpx;margin-top:6rpx;">请在 {{renewalDeadlineStr}} 前确认</view>
      <view wx:if="{{seasonDrive.note}}" class="text-muted" style="font-size:24rpx;margin-top:10rpx;line-height:1.6;">{{seasonDrive.note}}</view>

      <!-- already responded -->
      <block wx:if="{{myRenewal && myRenewal.response === 'continue' && myRenewal.status === 'pending'}}">
        <view style="font-size:26rpx;color:#F0B429;font-weight:700;margin-top:16rpx;">已确认继续，等管理员登记</view>
        <view class="text-muted" style="font-size:22rpx;margin-top:6rpx;">如需修改请联系管理员</view>
      </block>
      <block wx:elif="{{myRenewal && myRenewal.status === 'confirmed'}}">
        <view style="font-size:26rpx;color:#00C9A7;font-weight:700;margin-top:16rpx;">✓ 已登记 {{myRenewal.season}} 赛季年卡</view>
      </block>
      <block wx:elif="{{myRenewal && myRenewal.response === 'decline'}}">
        <view style="font-size:26rpx;color:#7A8FA6;font-weight:700;margin-top:16rpx;">你选择本赛季暂不继续</view>
        <view class="text-muted" style="font-size:22rpx;margin-top:6rpx;line-height:1.6;">换季后转为次卡，仍可报名，但失去 R1 优先和带朋友名额。随时可以改主意。</view>
        <button class="inline-btn" style="margin-top:16rpx;" bindtap="openRenewalModal">重新确认</button>
      </block>
      <block wx:elif="{{myRenewal && myRenewal.status === 'rejected'}}">
        <view style="font-size:26rpx;color:#E53E3E;font-weight:700;margin-top:16rpx;">上次确认被驳回</view>
        <button class="inline-btn" style="margin-top:16rpx;" bindtap="openRenewalModal">重新确认</button>
      </block>

      <!-- not responded yet -->
      <block wx:else>
        <view class="text-muted" style="font-size:24rpx;margin-top:12rpx;line-height:1.6;">你上赛季是年卡。确认继续可保留 R1 优先报名和带朋友的名额。</view>
        <view class="flex-row" style="gap:12rpx;margin-top:20rpx;">
          <button class="btn-primary" style="flex:1;" bindtap="openRenewalModal">确认继续</button>
          <button class="btn-ghost" style="flex:1;" bindtap="declineRenewal">暂不继续</button>
        </view>
      </block>
    </view>

    <!-- Membership application (members only — admins assign directly) -->
    <view wx:if="{{!isAdmin}}" class="card">
      <view wx:if="{{myAppStatus === 'pending'}}" class="flex-row" style="justify-content:space-between;align-items:center;">
        <view>
          <view style="font-size:28rpx;font-weight:700;color:#F0B429;">{{myAppTypeLabel}}申请审核中</view>
          <view class="text-muted" style="font-size:24rpx;margin-top:6rpx;">管理员审批后自动生效</view>
        </view>
        <button class="inline-btn" bindtap="cancelApplication">撤回</button>
      </view>
      <block wx:else>
        <view wx:if="{{myAppStatus === 'rejected'}}" style="margin-bottom:16rpx;">
          <view style="font-size:26rpx;font-weight:700;color:#E53E3E;">上次{{myAppTypeLabel}}申请未通过</view>
          <view wx:if="{{myAppReason}}" class="text-muted" style="font-size:24rpx;margin-top:4rpx;">原因:{{myAppReason}}</view>
        </view>
        <view class="flex-row" style="justify-content:space-between;align-items:center;">
          <view>
            <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">办理会员</view>
            <view class="text-muted" style="font-size:24rpx;margin-top:6rpx;">申请年卡 / 次卡，管理员审批</view>
          </view>
          <button class="inline-btn" bindtap="openApplyModal">{{myAppStatus === 'rejected' ? '重新申请' : '申请'}}</button>
        </view>
      </block>
    </view>

    <!-- Stats -->
    <view class="card">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:20rpx;">球员数据</view>
      <view class="flex-row" style="justify-content:space-around;text-align:center;">
        <view>
          <view style="font-size:48rpx;font-weight:900;color:#00C9A7;">{{user.attendanceCount}}</view>
          <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">出勤</view>
        </view>
        <view style="width:1rpx;background:#1E2D3D;height:60rpx;align-self:center;"></view>
        <view>
          <view style="font-size:48rpx;font-weight:900;color:{{user.lateCount > 0 ? '#F0B429' : '#e8f0eb'}};">{{user.lateCount}}</view>
          <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">当前迟到</view>
          <view class="text-muted" style="font-size:20rpx;">累计 {{user.lateCountTotal || 0}}</view>
        </view>
        <view style="width:1rpx;background:#1E2D3D;height:60rpx;align-self:center;"></view>
        <view>
          <view style="font-size:48rpx;font-weight:900;color:{{user.dangerousCount > 0 ? '#E53E3E' : '#e8f0eb'}};">{{user.dangerousCount}}</view>
          <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">危险动作</view>
          <view wx:if="{{user.absentCount > 0}}" class="text-muted" style="font-size:20rpx;">旷赛 {{user.absentCount}}</view>
        </view>
      </view>
      <view wx:if="{{user.gkHalvesOwed > 0}}" style="margin-top:20rpx;padding:16rpx 20rpx;background:rgba(229,62,62,0.12);border:1rpx solid rgba(229,62,62,0.4);border-radius:12rpx;font-size:23rpx;color:#FF8A8A;line-height:1.6;">🧤 因旷赛欠 {{user.gkHalvesOwed}} 个半场门将：报名时可选择守满全场一次还清，或分两场各守半场，赛后由队长/管理员核实扣减</view>
    </view>

    <!-- Edit name -->
    <view class="card">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">名字</view>
      <input
        value="{{displayName}}"
        bindinput="onNameInput"
        placeholder="输入你的名字"
        placeholder-style="color:#3A4E63"
        style="font-size:32rpx;font-weight:700;color:#e8f0eb;background:transparent;width:100%;" />
    </view>

    <!-- Edit positions -->
    <view class="card">
      <view class="flex-row" style="justify-content:space-between;margin-bottom:16rpx;">
        <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;">惯用位置</view>
        <view class="text-muted" style="font-size:22rpx;">按优先级选最多 3 个</view>
      </view>

      <!-- Priority display (selected) -->
      <view wx:if="{{priorityPositions.length > 0}}" style="display:flex;flex-direction:row;gap:16rpx;margin-bottom:20rpx;">
        <view wx:for="{{priorityPositions}}" wx:key="pos" style="text-align:center;">
          <view style="font-size:18rpx;font-weight:900;color:#00C9A7;text-transform:uppercase;margin-bottom:8rpx;">{{item.priorityLabel}}</view>
          <view class="pos-chip-selected" bindtap="removePosition" data-pos="{{item.pos}}">{{item.pos}}</view>
        </view>
      </view>

      <!-- Available positions -->
      <view style="display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx;">
        <view
          wx:for="{{availablePositions}}"
          wx:key="*this"
          class="pos-chip-avail {{selectedCount >= 3 ? 'pos-chip-disabled' : ''}}"
          bindtap="addPosition"
          data-pos="{{item}}">
          {{item}}
        </view>
      </view>
      <view wx:if="{{priorityPositions.length > 0}}" class="text-muted" style="font-size:22rpx;margin-top:12rpx;">点击已选位置可移除</view>
    </view>

    <!-- Save -->
    <button class="btn-primary" bindtap="saveProfile" disabled="{{saving || !displayName}}">
      {{saved ? '✓ 已保存' : saving ? '保存中...' : '保存'}}
    </button>

    <button wx:if="{{isAdmin}}" class="btn-ghost" bindtap="goAdmin">
      进入管理后台<text wx:if="{{pendingApplications > 0}}" class="admin-badge-dot">{{pendingApplications}}</text>
    </button>
    <button wx:if="{{isAdmin}}" class="btn-ghost" bindtap="goAttendance">出勤统计</button>

    <button class="btn-ghost btn-danger" bindtap="logout">退出登录</button>
    <navigator url="/pages/privacy/index" style="text-align:center;display:block;margin-top:24rpx;font-size:22rpx;color:#3A4E63;">隐私政策</navigator>

  </block>

  <!-- ── Membership application modal ─────────────────────────────────── -->
  <view wx:if="{{showApplyModal}}" class="modal-mask" catchtap="closeApplyModal">
    <view class="modal-box" catchtap="noop">
      <view style="font-size:32rpx;font-weight:700;color:#e8f0eb;margin-bottom:16rpx;">申请会员</view>
      <view class="contact-card" style="margin-bottom:24rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:10rpx;">提交申请前请先联系管理员办理</view>
        <view class="contact-name">{{adminContact.name}}</view>
      </view>


      <view class="flex-row" style="gap:16rpx;margin-bottom:24rpx;">
        <view class="apply-type-chip {{applyType === 'annual' ? 'active' : ''}}" bindtap="setApplyType" data-type="annual">年卡</view>
        <view class="apply-type-chip {{applyType === 'per_session' ? 'active' : ''}}" bindtap="setApplyType" data-type="per_session">次卡</view>
      </view>

      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">真实姓名（管理员核对用）</view>
        <input class="form-input" placeholder="例：王大明" value="{{applyRealName}}" bindinput="onRealNameInput" adjust-position="{{false}}"/>
      </view>
      <view style="margin-bottom:28rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">备注（选填）</view>
        <input class="form-input" placeholder="例：老王介绍来的" value="{{applyNote}}" bindinput="onNoteInput" adjust-position="{{false}}"/>
      </view>

      <view class="flex-row" style="gap:16rpx;">
        <button class="btn-ghost" style="flex:1;" bindtap="closeApplyModal">取消</button>
        <button class="btn-primary" style="flex:1;" bindtap="submitApplication" loading="{{applying}}">提交申请</button>
      </view>
    </view>
  </view>

  <!-- ── 赛季年卡登记 confirm sheet ─────────────────────────────────────── -->
  <view wx:if="{{showRenewalModal}}" class="modal-mask" catchtap="closeRenewalModal">
    <view class="modal-box" catchtap="noop">
      <view style="font-size:32rpx;font-weight:700;color:#e8f0eb;margin-bottom:8rpx;">确认继续年卡</view>
      <view class="text-muted" style="font-size:24rpx;margin-bottom:24rpx;">{{seasonDrive.season}} 赛季 · 提交后由管理员确认登记</view>

      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:10rpx;">生日（月-日，必填）</view>
        <picker mode="date" fields="day" value="2000-{{renewalBirthday || '01-01'}}" bindchange="onRenewalBirthdayChange">
          <view class="form-input">{{renewalBirthday || '选择月和日'}}</view>
        </picker>
        <view class="text-muted" style="font-size:20rpx;margin-top:8rpx;line-height:1.5;">只登记月和日，不记年份</view>
      </view>

      <view wx:for="{{renewalQs}}" wx:key="id" wx:for-item="q" style="margin-bottom:24rpx;">
        <view style="font-size:26rpx;font-weight:700;color:#e8f0eb;margin-bottom:10rpx;">
          {{q.title}}<text wx:if="{{q.required}}" style="color:#E53E3E;"> *</text>
          <text wx:if="{{q.type === 'multi'}}" class="text-muted" style="font-size:22rpx;font-weight:400;">（可多选）</text>
        </view>
        <input wx:if="{{q.type === 'text'}}" class="form-input" value="{{q.textValue}}" placeholder="填写..."
          bindinput="onRenewalAnswerText" data-qid="{{q.id}}" adjust-position="{{false}}"/>
        <view wx:else style="display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx;">
          <view wx:for="{{q.opts}}" wx:key="label" wx:for-item="o"
            class="rn-opt {{o.selected ? 'active' : ''}}"
            bindtap="pickRenewalOption" data-qid="{{q.id}}" data-opt="{{o.label}}" data-qtype="{{q.type}}">{{o.label}}</view>
        </view>
      </view>

      <view style="margin-bottom:24rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:10rpx;">留言（可留空）</view>
        <input class="form-input" value="{{renewalNote}}" bindinput="onRenewalNoteInput" placeholder="想跟管理员说的话"/>
      </view>

      <view class="flex-row" style="gap:16rpx;">
        <button class="btn-ghost" style="flex:1;" bindtap="closeRenewalModal">取消</button>
        <button class="btn-primary" style="flex:1;" bindtap="submitRenewal" loading="{{renewing}}">提交</button>
      </view>
    </view>
  </view>


  <!-- ── 赛季确认书 ─────────────────────────────────────────────────────── -->
  <view wx:if="{{showWaiverModal}}" class="modal-mask" catchtap="closeWaiverModal">
    <view class="modal-box" catchtap="noop">
      <view style="font-size:32rpx;font-weight:700;color:#e8f0eb;margin-bottom:6rpx;">{{seasonWaiver.title}}</view>
      <view class="text-muted" style="font-size:22rpx;margin-bottom:20rpx;">{{seasonWaiver.season}} 赛季 · 每赛季确认一次</view>

      <scroll-view scroll-y class="waiver-body">
        <text>{{seasonWaiver.body}}</text>
      </scroll-view>

      <block wx:if="{{!seasonWaiver.signed}}">
        <view style="margin:24rpx 0 20rpx;">
          <view class="text-muted" style="font-size:22rpx;margin-bottom:10rpx;">真实姓名</view>
          <input class="form-input" value="{{waiverRealName}}" bindinput="onWaiverName"
            placeholder="请填写与证件一致的姓名" adjust-position="{{false}}"/>
        </view>

        <view wx:if="{{seasonWaiver.handwriting}}" style="margin-bottom:20rpx;">
          <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:10rpx;">
            <view class="text-muted" style="font-size:22rpx;">在下方方框内签写姓名</view>
            <view class="pick-tap pick-tap-off" bindtap="clearSignature">重写</view>
          </view>
          <canvas type="2d" id="sigCanvas" class="sig-pad"
            bindtouchstart="onSigStart" bindtouchmove="onSigMove" disable-scroll="{{true}}"/>
        </view>

        <view class="flex-row" style="align-items:center;gap:16rpx;margin-bottom:24rpx;">
          <switch checked="{{waiverAgreed}}" bindchange="onWaiverAgree" color="#00C9A7" style="transform:scale(0.8);"/>
          <view style="font-size:24rpx;color:#e8f0eb;flex:1;line-height:1.5;">我已完整阅读并知悉以上全部内容</view>
        </view>

        <view class="flex-row" style="gap:16rpx;">
          <button class="btn-ghost" style="flex:1;" bindtap="closeWaiverModal">取消</button>
          <button class="btn-primary" style="flex:1;" bindtap="submitWaiver" loading="{{waiverSigning}}">确认</button>
        </view>
      </block>

      <button wx:else class="btn-ghost" style="margin-top:24rpx;" bindtap="closeWaiverModal">关闭</button>
    </view>
  </view>

</view>
