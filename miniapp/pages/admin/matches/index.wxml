<view class="container">
  <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:24rpx;">
    <view style="font-size:48rpx;font-weight:900;flex-shrink:0;">比赛管理</view>
    <view class="flex-row" style="gap:12rpx;">
      <button class="btn-ghost" style="padding:12rpx 20rpx;font-size:22rpx;" bindtap="toggleShowAll">{{showAll ? '隐藏已结束' : '显示全部'}}</button>
      <button class="btn-primary" style="padding:12rpx 28rpx;font-size:26rpx;" bindtap="openCreateModal">+ 新建</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="text-muted" style="text-align:center;padding:60rpx 0;">加载中...</view>

  <view wx:for="{{filteredMatches}}" wx:key="id" class="card" style="margin-bottom:16rpx;">
    <view class="flex-row" style="justify-content:space-between;align-items:flex-start;margin-bottom:16rpx;" bindtap="goDetail" data-id="{{item.id}}">
      <view>
        <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">{{item.dateStr}}</view>
        <view class="text-muted" style="font-size:26rpx;margin-top:4rpx;">{{item.location}} · 最多{{item.maxPlayers}}人</view>
      </view>
      <view class="badge {{item.statusBadge}}" style="flex-shrink:0;margin-left:16rpx;">{{item.statusLabel}}</view>
    </view>
    <view class="flex-row" style="gap:12rpx;flex-wrap:wrap;">
      <button
        wx:if="{{item.canAdvance}}"
        size="mini"
        class="btn-primary"
        style="flex:1;min-width:160rpx;font-size:24rpx;"
        catchtap="advanceStatus"
        data-id="{{item.id}}"
        data-next="{{item.nextStatus}}">
        → {{item.nextStatusLabel}}
      </button>
      <button
        wx:if="{{item.canForceReady}}"
        size="mini"
        class="btn-ghost"
        style="font-size:24rpx;"
        catchtap="forceReady"
        data-id="{{item.id}}">
        强制就绪
      </button>
      <button
        wx:if="{{item.canBackToR2}}"
        size="mini"
        class="btn-ghost"
        style="font-size:24rpx;"
        catchtap="backToR2"
        data-id="{{item.id}}">
        回到 R2
      </button>
      <button
        wx:if="{{item.canEdit}}"
        size="mini"
        class="btn-ghost"
        style="font-size:24rpx;"
        catchtap="openEditModal"
        data-id="{{item.id}}">
        编辑
      </button>
      <button
        wx:if="{{item.status !== 'completed' && item.status !== 'cancelled'}}"
        size="mini"
        class="btn-ghost"
        style="font-size:24rpx;"
        catchtap="cancelMatch"
        data-id="{{item.id}}">
        取消
      </button>
    </view>
  </view>

  <view wx:if="{{filteredMatches.length === 0 && !loading}}" class="card" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">{{showAll ? '暂无比赛' : '暂无进行中的比赛'}}</view>
  </view>

  <!-- Create / edit match modal -->
  <view wx:if="{{showCreateModal}}" class="modal-mask" catchtap="closeCreateModal">
    <view class="modal-box" catchtap="noop">
      <view style="font-size:32rpx;font-weight:700;color:#e8f0eb;margin-bottom:24rpx;">{{editingId ? '编辑比赛' : '新建比赛'}}</view>

      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">地点</view>
        <input class="form-input" placeholder="例：朝阳公园 5号场" value="{{form.location}}" bindinput="onFormLocation" adjust-position="{{false}}"/>
      </view>
      <view class="flex-row" style="gap:16rpx;margin-bottom:20rpx;">
        <view style="flex:1;">
          <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">日期</view>
          <picker mode="date" value="{{form.date}}" bindchange="onFormDate">
            <view class="form-input">{{form.date}}</view>
          </picker>
        </view>
        <view style="flex:1;">
          <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">开球时间 (ET)</view>
          <picker mode="time" value="{{form.time}}" bindchange="onFormTime">
            <view class="form-input">{{form.time}}</view>
          </picker>
        </view>
      </view>
      <view style="margin-bottom:28rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">最大人数</view>
        <input class="form-input" type="number" value="{{form.maxPlayers}}" bindinput="onFormPlayers" adjust-position="{{false}}"/>
      </view>

      <view class="flex-row" style="gap:16rpx;">
        <button class="btn-ghost" style="flex:1;" bindtap="closeCreateModal">取消</button>
        <button class="btn-primary" style="flex:1;" bindtap="submitMatch" loading="{{creating}}">{{editingId ? '保存' : '创建'}}</button>
      </view>
    </view>
  </view>
</view>
