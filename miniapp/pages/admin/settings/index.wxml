<view class="container">
  <view style="font-size:48rpx;font-weight:900;margin-bottom:32rpx;">系统设置</view>

  <view wx:if="{{loading}}" class="text-muted" style="text-align:center;padding:60rpx 0;">加载中...</view>

  <view wx:elif="{{loadError || !config}}" style="text-align:center;padding:60rpx 0;">
    <view class="text-muted" style="margin-bottom:24rpx;">加载失败，请检查网络</view>
    <button class="btn-ghost" style="display:inline-block;" bindtap="retryLoad">重试</button>
  </view>

  <block wx:elif="{{config}}">
    <view class="card" style="margin-bottom:24rpx;">
      <view style="font-size:24rpx;font-weight:700;color:#7A8FA6;margin-bottom:20rpx;text-transform:uppercase;letter-spacing:3rpx;">基本设置</view>

      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">赛季</view>
        <input class="settings-input" value="{{config.season}}" data-field="season" bindinput="onInput" placeholder="例：2025-2026"/>
      </view>
      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">单次参赛费用 (¥)</view>
        <input class="settings-input" type="digit" value="{{config.perSessionFee}}" data-field="perSessionFee" bindinput="onInput"/>
      </view>
      <view>
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">补位确认时限 (分钟)</view>
        <input class="settings-input" type="number" value="{{config.waitlistConfirmMinutes}}" data-field="waitlistConfirmMinutes" bindinput="onInput"/>
      </view>
    </view>

    <view class="card" style="margin-bottom:24rpx;">
      <view style="font-size:24rpx;font-weight:700;color:#7A8FA6;margin-bottom:20rpx;text-transform:uppercase;letter-spacing:3rpx;">自动循环</view>

      <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:20rpx;">
        <view style="font-size:28rpx;color:#e8f0eb;">启用自动循环</view>
        <switch checked="{{config.autoRecurring}}" bindchange="onSwitch" data-field="autoRecurring" color="#00C9A7"/>
      </view>

      <block wx:if="{{config.autoRecurring}}">
        <view style="margin-bottom:20rpx;">
          <view class="text-muted" style="font-size:22rpx;margin-bottom:12rpx;">每周（可多选）</view>
          <view style="display:flex;flex-direction:row;flex-wrap:wrap;gap:12rpx;">
            <view
              wx:for="{{weekdays}}"
              wx:key="index"
              class="day-chip {{recurringDaysMap[index] ? 'day-chip-active' : ''}}"
              bindtap="toggleDay"
              data-day="{{index}}">
              {{item}}
            </view>
          </view>
        </view>

        <view class="flex-row" style="gap:16rpx;margin-bottom:20rpx;">
          <view style="flex:1;">
            <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">开球时 (ET)</view>
            <input class="settings-input" type="number" value="{{config.recurringHour}}" data-field="recurringHour" bindinput="onInput"/>
          </view>
          <view style="flex:1;">
            <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">分钟</view>
            <input class="settings-input" type="number" value="{{config.recurringMinute}}" data-field="recurringMinute" bindinput="onInput"/>
          </view>
        </view>

        <view style="margin-bottom:20rpx;">
          <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">默认地点</view>
          <input class="settings-input" value="{{config.recurringLocation}}" data-field="recurringLocation" bindinput="onInput" placeholder="例：朝阳公园 5号场"/>
        </view>

        <view style="margin-bottom:20rpx;">
          <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">默认最大人数</view>
          <input class="settings-input" type="number" value="{{config.recurringMaxPlayers}}" data-field="recurringMaxPlayers" bindinput="onInput"/>
        </view>

        <view style="margin-bottom:20rpx;">
          <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">冬歇开始（留空不设置）</view>
          <picker mode="date" value="{{config.winterBreakStart}}" bindchange="onDatePicker" data-field="winterBreakStart">
            <view class="settings-input">{{config.winterBreakStart || '不设置'}}</view>
          </picker>
        </view>

        <view>
          <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">冬歇结束</view>
          <picker mode="date" value="{{config.winterBreakEnd}}" bindchange="onDatePicker" data-field="winterBreakEnd">
            <view class="settings-input">{{config.winterBreakEnd || '不设置'}}</view>
          </picker>
        </view>
      </block>
    </view>

    <view class="card" style="margin-bottom:24rpx;">
      <view style="font-size:24rpx;font-weight:700;color:#7A8FA6;margin-bottom:20rpx;text-transform:uppercase;letter-spacing:3rpx;">默认公告</view>
      <textarea class="settings-textarea" value="{{config.defaultAnnouncement}}" data-field="defaultAnnouncement" bindinput="onInput" auto-height placeholder="首页公告内容..."/>
    </view>

    <view class="card" style="margin-bottom:32rpx;">
      <view style="font-size:24rpx;font-weight:700;color:#7A8FA6;margin-bottom:20rpx;text-transform:uppercase;letter-spacing:3rpx;">默认报名协议</view>
      <textarea class="settings-textarea" value="{{config.defaultAgreementText}}" data-field="defaultAgreementText" bindinput="onInput" auto-height placeholder="报名协议文本..."/>
    </view>

    <button class="btn-primary" bindtap="save" loading="{{saving}}">保存设置</button>
  </block>
</view>
