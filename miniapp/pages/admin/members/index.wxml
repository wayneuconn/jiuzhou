<view class="container">
  <view style="font-size:48rpx;font-weight:900;margin-bottom:24rpx;">
    成员管理
    <text style="font-size:28rpx;font-weight:400;color:#7A8FA6;">{{filteredMembers.length}}/{{members.length}}人</text>
  </view>

  <!-- Membership filter (newest members first) -->
  <view class="flex-row" style="gap:12rpx;margin-bottom:20rpx;">
    <view wx:for="{{filters}}" wx:key="key"
      class="member-filter-chip {{filter === item.key ? 'active' : ''}}"
      bindtap="setFilter" data-key="{{item.key}}">{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="text-muted" style="text-align:center;padding:60rpx 0;">加载中...</view>

  <view wx:for="{{filteredMembers}}" wx:key="id" class="card member-row">
    <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:12rpx;">
      <view style="flex:1;min-width:0;">
        <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">{{item.displayName}}</view>
        <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">{{item.phone ? item.phone + ' · ' : ''}}出勤{{item.attendanceCount}}场</view>
      </view>
      <view class="flex-row" style="gap:10rpx;flex-shrink:0;margin-left:12rpx;">
        <view class="badge {{item.membershipBadge}}" bindtap="changeMembership" data-id="{{item.id}}" data-current="{{item.membershipType}}">{{item.membershipLabel}}</view>
        <view class="badge badge-grey" bindtap="changeRole" data-id="{{item.id}}" data-current="{{item.role}}">{{item.roleLabel}}</view>
        <view class="badge {{item.isBanned ? 'badge-red' : 'badge-grey'}}" bindtap="banPlayer" data-id="{{item.id}}" data-current="{{item.banGamesLeft}}">
          {{item.isBanned ? '禁赛' + item.banGamesLeft : '禁赛'}}
        </view>
      </view>
    </view>
    <view wx:if="{{item.lateCount > 0 || item.dangerousCount > 0}}" class="flex-row" style="gap:12rpx;">
      <view wx:if="{{item.lateCount > 0}}" class="badge badge-gold">迟到 {{item.lateCount}}</view>
      <view wx:if="{{item.dangerousCount > 0}}" class="badge badge-red">危险 {{item.dangerousCount}}</view>
    </view>
  </view>

  <view wx:if="{{filteredMembers.length === 0 && !loading}}" class="card" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">该分类下暂无成员</view>
  </view>
</view>
