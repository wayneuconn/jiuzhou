<view class="container">
  <view style="font-size:48rpx;font-weight:900;margin-bottom:32rpx;">管理后台</view>

  <view class="flex-row" style="gap:16rpx;margin-bottom:16rpx;">
    <view class="card" style="flex:1;text-align:center;padding:32rpx 0;">
      <view style="font-size:56rpx;font-weight:900;color:#00C9A7;">{{memberCount}}</view>
      <view class="text-muted" style="font-size:24rpx;margin-top:8rpx;">会员</view>
    </view>
    <view class="card" style="flex:1;text-align:center;padding:32rpx 0;">
      <view style="font-size:56rpx;font-weight:900;color:#F0B429;">{{activeMatchCount}}</view>
      <view class="text-muted" style="font-size:24rpx;margin-top:8rpx;">进行中比赛</view>
    </view>
  </view>

  <!-- Next match live board -->
  <view wx:if="{{board}}" class="card" style="margin-bottom:24rpx;" bindtap="goBoard">
    <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:16rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;">下一场 · {{board.statusLabel}}</view>
      <view style="color:#7A8FA6;font-size:28rpx;">›</view>
    </view>
    <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;margin-bottom:16rpx;">{{board.dateStr}}</view>
    <view class="flex-row" style="justify-content:space-around;text-align:center;">
      <view>
        <view style="font-size:40rpx;font-weight:900;color:{{board.confirmed >= board.maxPlayers ? '#F0B429' : '#00C9A7'}};">{{board.confirmed}}/{{board.maxPlayers}}</view>
        <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">已报名</view>
      </view>
      <view>
        <view style="font-size:40rpx;font-weight:900;color:#e8f0eb;">{{board.waitlist}}</view>
        <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">候补</view>
      </view>
      <view>
        <view style="font-size:40rpx;font-weight:900;color:{{board.excused > 0 ? '#F0B429' : '#e8f0eb'}};">{{board.excused}}</view>
        <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">请假</view>
      </view>
    </view>
  </view>

  <view class="card menu-item" bindtap="go" data-url="/pages/admin/matches/index">
    <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">比赛管理</view>
    <view style="color:#7A8FA6;font-size:32rpx;">›</view>
  </view>
  <view class="card menu-item" bindtap="go" data-url="/pages/admin/members/index">
    <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">成员管理</view>
    <view style="color:#7A8FA6;font-size:32rpx;">›</view>
  </view>
  <view class="card menu-item" bindtap="go" data-url="/pages/admin/applications/index">
    <view class="flex-row" style="gap:12rpx;align-items:center;">
      <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">会员申请</view>
      <view wx:if="{{pendingApplications > 0}}" class="badge badge-red">{{pendingApplications}} 待审批</view>
    </view>
    <view style="color:#7A8FA6;font-size:32rpx;">›</view>
  </view>
  <view class="card menu-item" bindtap="go" data-url="/pages/admin/attendance/index">
    <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">出勤统计</view>
    <view style="color:#7A8FA6;font-size:32rpx;">›</view>
  </view>
  <view class="card menu-item" bindtap="go" data-url="/pages/admin/announcements/index">
    <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">公告管理</view>
    <view style="color:#7A8FA6;font-size:32rpx;">›</view>
  </view>
  <view class="card menu-item" bindtap="go" data-url="/pages/admin/settings/index">
    <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">系统设置</view>
    <view style="color:#7A8FA6;font-size:32rpx;">›</view>
  </view>
</view>
