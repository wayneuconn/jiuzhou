<view class="container">
  <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:24rpx;">
    <view style="font-size:48rpx;font-weight:900;">公告管理</view>
    <button class="btn-primary" style="padding:12rpx 28rpx;font-size:26rpx;" bindtap="openNew">+ 新建</button>
  </view>

  <view wx:if="{{loading}}" class="text-muted" style="text-align:center;padding:60rpx 0;">加载中...</view>

  <view wx:for="{{announcements}}" wx:key="id" class="card" style="margin-bottom:16rpx;">
    <view class="flex-row" style="justify-content:space-between;align-items:flex-start;margin-bottom:12rpx;">
      <view style="flex:1;min-width:0;">
        <view class="flex-row" style="gap:12rpx;align-items:center;margin-bottom:8rpx;">
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">{{item.title}}</view>
          <view wx:if="{{item.pinned}}" class="badge badge-teal">置顶</view>
        </view>
        <view class="text-muted" style="font-size:24rpx;line-height:1.5;">{{item.content}}</view>
      </view>
    </view>
    <view class="flex-row" style="gap:12rpx;justify-content:flex-end;">
      <button size="mini" class="btn-ghost" style="font-size:24rpx;" catchtap="openEdit" data-id="{{item.id}}">编辑</button>
      <button size="mini" class="btn-ghost btn-danger" style="font-size:24rpx;" catchtap="deleteAnn" data-id="{{item.id}}">删除</button>
    </view>
  </view>

  <view wx:if="{{announcements.length === 0 && !loading}}" class="card" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">暂无公告</view>
  </view>

  <!-- Modal -->
  <view wx:if="{{showModal}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-box" catchtap="noop">
      <view style="font-size:32rpx;font-weight:700;color:#e8f0eb;margin-bottom:24rpx;">{{form.id ? '编辑公告' : '新建公告'}}</view>

      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">标题</view>
        <input class="ann-input" value="{{form.title}}" bindinput="onTitle" placeholder="公告标题" adjust-position="{{false}}"/>
      </view>
      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">内容</view>
        <textarea class="ann-textarea" value="{{form.content}}" bindinput="onContent" placeholder="公告内容..." auto-height adjust-position="{{false}}" maxlength="-1"/>
        <view class="text-muted" style="font-size:20rpx;margin-top:8rpx;">支持 Markdown：**粗体**、- 列表、### 标题、--- 分割线</view>
      </view>
      <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:28rpx;">
        <view style="font-size:28rpx;color:#e8f0eb;">置顶</view>
        <switch checked="{{form.pinned}}" bindchange="onPinned" color="#00C9A7"/>
      </view>

      <view class="flex-row" style="gap:16rpx;">
        <button class="btn-ghost" style="flex:1;" bindtap="closeModal">取消</button>
        <button class="btn-primary" style="flex:1;" bindtap="save" loading="{{saving}}">保存</button>
      </view>
    </view>
  </view>
</view>
