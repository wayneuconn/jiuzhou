<view class="container">
  <view style="font-size:48rpx;font-weight:900;margin-bottom:32rpx;">出勤统计</view>

  <!-- Date range pickers -->
  <view class="card" style="margin-bottom:24rpx;">
    <view class="flex-row" style="gap:16rpx;align-items:center;">
      <view style="flex:1;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">开始日期</view>
        <picker mode="date" value="{{fromDate}}" bindchange="onFromChange">
          <view class="date-picker-val">{{fromDate}}</view>
        </picker>
      </view>
      <view style="color:#7A8FA6;font-size:28rpx;padding-top:24rpx;">—</view>
      <view style="flex:1;">
        <view class="text-muted" style="font-size:22rpx;margin-bottom:8rpx;">结束日期</view>
        <picker mode="date" value="{{toDate}}" bindchange="onToChange">
          <view class="date-picker-val">{{toDate}}</view>
        </picker>
      </view>
    </view>
    <button
      class="btn-primary"
      style="margin-top:24rpx;"
      bindtap="query"
      disabled="{{loading}}">
      {{loading ? '查询中…' : '查询'}}
    </button>
  </view>

  <!-- Results -->
  <view wx:if="{{searched}}">
    <view style="font-size:22rpx;color:#7A8FA6;margin-bottom:16rpx;">
      共 {{matchCount}} 场已完赛比赛 · {{stats.length}} 名球员
    </view>

    <view wx:if="{{stats.length === 0}}" class="card" style="text-align:center;padding:64rpx 0;">
      <view class="text-muted">该时间段内无出勤记录</view>
    </view>

    <view
      wx:for="{{stats}}"
      wx:key="uid"
      class="card stat-row">
      <view class="flex-row" style="justify-content:space-between;align-items:center;">
        <!-- Rank + name -->
        <view class="flex-row" style="gap:20rpx;align-items:center;flex:1;min-width:0;">
          <view class="rank-badge">{{index + 1}}</view>
          <view style="flex:1;min-width:0;">
            <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">{{item.displayName}}</view>
            <view wx:if="{{item.preferredPositions.length > 0}}" class="text-muted" style="font-size:22rpx;margin-top:4rpx;">
              {{item.preferredPositions[0]}}
              <text wx:if="{{item.preferredPositions[1]}}"> · {{item.preferredPositions[1]}}</text>
            </view>
          </view>
        </view>
        <!-- Count -->
        <view style="text-align:right;flex-shrink:0;margin-left:16rpx;">
          <view style="font-size:40rpx;font-weight:900;color:#00C9A7;">{{item.count}}</view>
          <view class="text-muted" style="font-size:20rpx;">场</view>
        </view>
      </view>
      <!-- Tags -->
      <view wx:if="{{item.lateCount > 0 || item.dangerousCount > 0}}" class="flex-row" style="gap:12rpx;margin-top:12rpx;">
        <view wx:if="{{item.lateCount > 0}}" class="badge badge-gold">迟到 {{item.lateCount}}</view>
        <view wx:if="{{item.dangerousCount > 0}}" class="badge badge-red">危险 {{item.dangerousCount}}</view>
      </view>
    </view>
  </view>
</view>
