<view class="container">
  <view style="font-size:48rpx;font-weight:900;margin-bottom:24rpx;">缴费管理</view>

  <view wx:if="{{loading}}" class="text-muted" style="text-align:center;padding:60rpx 0;">加载中...</view>

  <block wx:else>
    <view wx:if="{{pending.length > 0}}" style="margin-bottom:24rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">待确认 ({{pending.length}})</view>
      <view wx:for="{{pending}}" wx:key="id" wx:for-item="item" class="card" style="margin-bottom:16rpx;">
        <view class="flex-row" style="justify-content:space-between;align-items:center;">
          <view>
            <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">{{item.displayName}}</view>
            <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">¥{{item.amount}} · {{item.membershipType}}</view>
          </view>
          <button class="btn-primary" style="padding:12rpx 24rpx;font-size:24rpx;" catchtap="confirm" data-id="{{item.id}}">确认</button>
        </view>
      </view>
    </view>

    <view wx:if="{{confirmed.length > 0}}">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">已确认 ({{confirmed.length}})</view>
      <view wx:for="{{confirmed}}" wx:key="id" wx:for-item="item" class="card" style="margin-bottom:16rpx;">
        <view class="flex-row" style="justify-content:space-between;align-items:center;">
          <view>
            <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">{{item.displayName}}</view>
            <view class="text-muted" style="font-size:22rpx;margin-top:4rpx;">¥{{item.amount}} · {{item.membershipType}}</view>
          </view>
          <view class="badge badge-teal">已确认</view>
        </view>
      </view>
    </view>

    <view wx:if="{{pending.length === 0 && confirmed.length === 0}}" class="card" style="text-align:center;padding:80rpx 0;">
      <view class="text-muted">暂无缴费记录</view>
    </view>
  </block>
</view>
