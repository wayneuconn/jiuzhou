/* .card / .badge / .btn-* / .text-muted / .flex-row come from app.wxss.
   These three are page-scoped elsewhere in the app, so they're repeated here
   rather than promoted to global — same shape as match-detail / settings. */

.player-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #1E2D3D;
}

.player-row:last-child { border-bottom: none; }

.settings-input {
  background: #1A2535;
  border: 1rpx solid #1E2D3D;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #e8f0eb;
  width: 100%;
  box-sizing: border-box;
}

input.settings-input { height: 88rpx; }

.pick-tap {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  line-height: 1.2;
  white-space: nowrap;
  text-align: center;
}

.pick-tap:active { opacity: 0.6; }
.pick-tap-off { background: transparent; color: #7A8FA6; border: 1rpx solid #1E2D3D; }

/* Question builder — mirrors the .ev-* rules on pages/admin/events */
.sn-qcard {
  background: #141C28;
  border: 1rpx solid #1E2D3D;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.sn-qtype {
  font-size: 22rpx;
  font-weight: 700;
  color: #00C9A7;
  background: rgba(0,201,167,0.1);
  border: 1rpx solid rgba(0,201,167,0.3);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.sn-del {
  font-size: 22rpx;
  color: #E53E3E;
  padding: 6rpx 10rpx;
}
