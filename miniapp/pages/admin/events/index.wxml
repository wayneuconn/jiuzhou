<view class="container">
  <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:24rpx;">
    <view style="font-size:48rpx;font-weight:900;">表单管理</view>
    <button class="btn-primary" style="padding:12rpx 28rpx;font-size:26rpx;" bindtap="openNew">+ 新建</button>
  </view>

  <!-- Workflow guide -->
  <view style="background:rgba(0,201,167,0.08);border:1rpx solid rgba(0,201,167,0.25);border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;">
    <view style="font-size:24rpx;font-weight:700;color:#00C9A7;margin-bottom:8rpx;">💡 怎么用</view>
    <view class="text-muted" style="font-size:22rpx;line-height:1.8;">① 新建 → 写问题 → 详情页点「开放」。一步填完一次提交，招新、意向调查、订队服都这样</view>
    <view class="text-muted" style="font-size:22rpx;line-height:1.8;">② 只有当后面的问题要看前面的答案才定（先投日期、定下来再报名），才加「第一轮问题」</view>
    <view class="text-muted" style="font-size:22rpx;line-height:1.8;">③ 球衣号码：用填空题打开「不能重复」，填过的号别人就用不了</view>
    <view class="text-muted" style="font-size:22rpx;line-height:1.8;">④ 要问带几位家属 / 订几件，用「数字」题；勾上「算人数」才计入人数上限</view>
  </view>

  <view wx:if="{{loading}}" class="text-muted" style="text-align:center;padding:60rpx 0;">加载中...</view>

  <view wx:for="{{events}}" wx:key="id" class="card" style="margin-bottom:16rpx;">
    <view class="flex-row" style="justify-content:space-between;align-items:flex-start;margin-bottom:16rpx;" bindtap="goDetail" data-id="{{item.id}}">
      <view style="flex:1;min-width:0;">
        <view style="font-size:30rpx;font-weight:700;color:#e8f0eb;">{{item.title}}</view>
        <view class="text-muted" style="font-size:24rpx;margin-top:4rpx;">{{item.dateStr}}<text wx:if="{{item.location}}"> · {{item.location}}</text></view>
      </view>
      <view class="badge {{item.statusBadge}}" style="flex-shrink:0;margin-left:16rpx;">{{item.statusLabel}}</view>
    </view>
    <view class="flex-row" style="gap:12rpx;justify-content:flex-end;">
      <button size="mini" class="btn-ghost" style="font-size:24rpx;" catchtap="openEdit" data-id="{{item.id}}">编辑</button>
      <button size="mini" class="btn-primary" style="font-size:24rpx;" catchtap="goDetail" data-id="{{item.id}}">详情 / 阶段管理</button>
    </view>
  </view>

  <view wx:if="{{events.length === 0 && !loading}}" class="card" style="text-align:center;padding:80rpx 0;">
    <view style="font-size:80rpx;">📋</view>
    <view class="text-muted" style="margin-top:16rpx;">还没有表单，点右上角新建</view>
  </view>

  <!-- Create / edit modal -->
  <view wx:if="{{showModal}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-box" catchtap="noop">
      <view style="font-size:32rpx;font-weight:700;color:#e8f0eb;margin-bottom:24rpx;">{{editingId ? '编辑表单' : '新建表单'}}</view>

      <view class="ev-field">
        <view class="ev-label">标题</view>
        <input class="form-input" value="{{form.title}}" bindinput="onField" data-field="title" placeholder="例：26-27 赛季招新" adjust-position="{{false}}"/>
      </view>
      <view class="ev-field">
        <view class="ev-label">描述（支持 Markdown）</view>
        <textarea class="form-input" style="height:160rpx;line-height:1.6;padding-top:16rpx;" value="{{form.description}}" bindinput="onField" data-field="description" placeholder="说明、背景..." adjust-position="{{false}}" maxlength="-1"/>
      </view>
      <view class="ev-field">
        <view class="ev-label">地点</view>
        <input class="form-input" value="{{form.location}}" bindinput="onField" data-field="location" placeholder="没有就留空" adjust-position="{{false}}"/>
      </view>
      <view class="flex-row" style="gap:16rpx;" >
        <view class="ev-field" style="flex:1;">
          <view class="ev-label">日期（没有就留空）</view>
          <picker mode="date" value="{{form.eventDate}}" bindchange="onPicker" data-field="eventDate">
            <view class="form-input">{{form.eventDate || '待定'}}</view>
          </picker>
        </view>
        <view class="ev-field" style="flex:1;">
          <view class="ev-label">时间</view>
          <picker mode="time" value="{{form.eventTime}}" bindchange="onPicker" data-field="eventTime">
            <view class="form-input">{{form.eventTime}}</view>
          </picker>
        </view>
      </view>
      <view class="flex-row" style="gap:16rpx;">
        <view class="ev-field" style="flex:1;">
          <view class="ev-label">报名截止日期</view>
          <picker mode="date" value="{{form.deadlineDate}}" bindchange="onPicker" data-field="deadlineDate">
            <view class="form-input">{{form.deadlineDate || '不限'}}</view>
          </picker>
        </view>
        <view class="ev-field" style="flex:1;">
          <view class="ev-label">截止时间</view>
          <picker mode="time" value="{{form.deadlineTime}}" bindchange="onPicker" data-field="deadlineTime">
            <view class="form-input">{{form.deadlineTime}}</view>
          </picker>
        </view>
      </view>
      <view class="ev-field">
        <view class="ev-label">谁能参与</view>
        <picker range="{{scopes}}" range-key="label" value="{{form.scopeIndex}}" bindchange="onScope">
          <view class="form-input">{{scopes[form.scopeIndex].label}}</view>
        </picker>
      </view>
      <view class="flex-row" style="gap:16rpx;">
        <view class="ev-field" style="flex:1;">
          <view class="ev-label">按钮上写什么</view>
          <picker range="{{actionLabels}}" value="{{form.actionIndex}}" bindchange="onAction">
            <view class="form-input">{{actionLabels[form.actionIndex]}}</view>
          </picker>
        </view>
        <view class="ev-field" style="flex:1;">
          <view class="ev-label">名单给谁看</view>
          <picker range="{{rosters}}" range-key="label" value="{{form.rosterIndex}}" bindchange="onRoster">
            <view class="form-input">{{rosters[form.rosterIndex].label}}</view>
          </picker>
        </view>
      </view>
      <view class="ev-field">
        <view class="ev-label">总人数上限（留空不限）</view>
        <input class="form-input" type="number" value="{{form.maxAttendees}}" bindinput="onField" data-field="maxAttendees" adjust-position="{{false}}"/>
      </view>

      <!-- Main questions -->
      <view class="ev-section">问题</view>
      <view class="text-muted" style="font-size:22rpx;margin-bottom:12rpx;line-height:1.6;">大家一次填完这些就提交。填空题的回答只有管理员能看到——除非打开「不能重复」（比如球衣号码：自己填号，填过的别人就不能再用，大家看得到谁占了哪个）。单选题的「先到先得」同理。数字题可以勾「算人数」计入人数上限。</view>
      <view wx:for="{{mainQs}}" wx:key="id" wx:for-item="q" wx:for-index="qi" class="ev-qcard">
        <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:12rpx;">
          <picker range="{{qTypes}}" range-key="label" value="{{q.typeIndex}}" bindchange="onQType" data-phase="main" data-index="{{qi}}">
            <view class="ev-qtype">{{qTypes[q.typeIndex].label}} ▾</view>
          </picker>
          <view class="flex-row" style="align-items:center;gap:12rpx;">
            <block wx:if="{{qTypes[q.typeIndex].key === 'single' || qTypes[q.typeIndex].key === 'text'}}">
              <view class="text-muted" style="font-size:22rpx;">{{qTypes[q.typeIndex].key === 'text' ? '不能重复' : '先到先得'}}</view>
              <switch checked="{{q.exclusive}}" bindchange="onQExclusive" data-index="{{qi}}" color="#F0B429" style="transform:scale(0.7);"/>
            </block>
            <block wx:if="{{qTypes[q.typeIndex].key === 'number'}}">
              <view class="text-muted" style="font-size:22rpx;">算人数</view>
              <switch checked="{{q.countsSeats}}" bindchange="onQSeats" data-index="{{qi}}" color="#F0B429" style="transform:scale(0.7);"/>
            </block>
            <view class="text-muted" style="font-size:22rpx;">必答</view>
            <switch checked="{{q.required}}" bindchange="onQRequired" data-phase="main" data-index="{{qi}}" color="#00C9A7" style="transform:scale(0.7);"/>
            <view class="ev-del" bindtap="delQ" data-phase="main" data-index="{{qi}}">删除</view>
          </view>
        </view>
        <input class="form-input" style="margin-bottom:12rpx;" value="{{q.title}}" placeholder="问题，例：球衣号码"
          bindinput="onQField" data-phase="main" data-index="{{qi}}" data-field="title" adjust-position="{{false}}"/>
        <input wx:if="{{qTypes[q.typeIndex].key === 'number'}}" class="form-input" type="number" value="{{q.max}}" placeholder="最多可以填几"
          bindinput="onQField" data-phase="main" data-index="{{qi}}" data-field="max" adjust-position="{{false}}"/>
        <input wx:elif="{{qTypes[q.typeIndex].key !== 'text'}}" class="form-input" value="{{q.options}}" placeholder="选项用 / 分隔，例：7/9/10/11"
          bindinput="onQField" data-phase="main" data-index="{{qi}}" data-field="options" adjust-position="{{false}}"/>
      </view>
      <button size="mini" class="btn-ghost" style="font-size:24rpx;margin-bottom:24rpx;" bindtap="addQ" data-phase="main">+ 添加问题</button>

      <!-- Optional first round -->
      <view class="ev-section">第一轮问题（一般留空）</view>
      <view class="text-muted" style="font-size:22rpx;margin-bottom:12rpx;line-height:1.6;">只有当上面的问题要等这一轮的结果才定得下来，才需要它——比如先投个日期，定了再开放报名。答这轮不算提交，票数大家都看得到。</view>
      <view wx:for="{{prepQs}}" wx:key="id" wx:for-item="q" wx:for-index="qi" class="ev-qcard">
        <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:12rpx;">
          <picker range="{{qTypes}}" range-key="label" value="{{q.typeIndex}}" bindchange="onQType" data-phase="prep" data-index="{{qi}}">
            <view class="ev-qtype">{{qTypes[q.typeIndex].label}} ▾</view>
          </picker>
          <view class="flex-row" style="align-items:center;gap:12rpx;">
            <view class="text-muted" style="font-size:22rpx;">必答</view>
            <switch checked="{{q.required}}" bindchange="onQRequired" data-phase="prep" data-index="{{qi}}" color="#00C9A7" style="transform:scale(0.7);"/>
            <view class="ev-del" bindtap="delQ" data-phase="prep" data-index="{{qi}}">删除</view>
          </view>
        </view>
        <input class="form-input" style="margin-bottom:12rpx;" value="{{q.title}}" placeholder="问题，例：哪天有空？"
          bindinput="onQField" data-phase="prep" data-index="{{qi}}" data-field="title" adjust-position="{{false}}"/>
        <input wx:if="{{qTypes[q.typeIndex].key === 'number'}}" class="form-input" type="number" value="{{q.max}}" placeholder="最多可以填几"
          bindinput="onQField" data-phase="prep" data-index="{{qi}}" data-field="max" adjust-position="{{false}}"/>
        <input wx:elif="{{qTypes[q.typeIndex].key !== 'text'}}" class="form-input" value="{{q.options}}" placeholder="选项用 / 分隔，例：8月15日/8月22日"
          bindinput="onQField" data-phase="prep" data-index="{{qi}}" data-field="options" adjust-position="{{false}}"/>
      </view>
      <button size="mini" class="btn-ghost" style="font-size:24rpx;margin-bottom:24rpx;" bindtap="addQ" data-phase="prep">+ 添加第一轮问题</button>

      <view class="flex-row" style="gap:16rpx;">
        <button class="btn-ghost" style="flex:1;" bindtap="closeModal">取消</button>
        <button class="btn-primary" style="flex:1;" bindtap="save" loading="{{saving}}">保存</button>
      </view>
    </view>
  </view>
</view>
