<view class="container">
  <view wx:if="{{isEntry}}" bindtap="goHome"
    style="display:flex;align-items:center;gap:8rpx;padding:20rpx 0 8rpx;color:#7A8FA6;font-size:26rpx;">
    <text style="font-size:30rpx;">‹</text><text>返回首页</text>
  </view>

  <view wx:if="{{loading}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">加载中...</view>
  </view>

  <view wx:elif="{{loadError}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted" style="margin-bottom:24rpx;">加载失败，请检查网络</view>
    <button class="btn-ghost" style="display:inline-block;" bindtap="retryLoad">重试</button>
  </view>

  <block wx:elif="{{match}}">

    <!-- ── Match header ───────────────────────────────────────────────── -->
    <view class="match-header">
      <view class="header-accent"></view>
      <view style="padding:32rpx;">
        <view class="flex-row" style="justify-content:space-between;align-items:flex-start;gap:24rpx;">
          <view style="flex:1;">
            <view style="font-size:22rpx;font-weight:900;color:#00C9A7;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:12rpx;">Match Day</view>
            <view style="font-size:36rpx;font-weight:900;color:#e8f0eb;line-height:1.2;">{{dateStr}}</view>
            <view class="text-muted" style="font-size:28rpx;margin-top:6rpx;">{{match.location}}</view>
          </view>
          <view style="font-size:22rpx;color:#3A4E63;text-align:right;line-height:1.5;">点击右上角<br/>··· 分享</view>
        </view>
        <view wx:if="{{hasScore}}" class="flex-row" style="align-items:center;gap:20rpx;margin-top:20rpx;">
          <view style="font-size:24rpx;font-weight:900;color:#3B82F6;">A队</view>
          <view style="font-size:44rpx;font-weight:900;color:#e8f0eb;">{{match.scoreA}} : {{match.scoreB}}</view>
          <view style="font-size:24rpx;font-weight:900;color:#EF4444;">B队</view>
        </view>
        <view class="flex-row" style="gap:12rpx;flex-wrap:wrap;margin-top:20rpx;">
          <view class="badge {{statusBadge}}">{{statusLabel}}</view>
          <view wx:if="{{captainAName}}" class="badge badge-team-a">队长A · {{captainAName}}</view>
          <view wx:if="{{captainBName}}" class="badge badge-team-b">队长B · {{captainBName}}</view>
          <view class="badge badge-grey" bindtap="openRulesModal">📖 报名规则</view>
        </view>
        <view wx:if="{{scheduleLine1}}" style="margin-top:16rpx;">
          <view class="text-muted" style="font-size:22rpx;line-height:1.6;">⏱ {{scheduleLine1}}</view>
          <view wx:if="{{scheduleLine2}}" class="text-muted" style="font-size:22rpx;line-height:1.6;">🔒 {{scheduleLine2}}</view>
        </view>
      </view>
    </view>

    <!-- ── Action area ────────────────────────────────────────────────── -->

    <!-- cancelled -->
    <view wx:if="{{actionState === 'cancelled'}}" class="action-card action-cancelled">
      <view style="font-size:30rpx;font-weight:900;color:#E53E3E;">比赛已取消</view>
      <view class="text-muted" style="font-size:26rpx;margin-top:8rpx;">本场比赛已被取消，请关注后续通知</view>
    </view>

    <!-- promoted (countdown) -->
    <view wx:elif="{{actionState === 'promoted'}}" class="action-card action-promoted">
      <view class="flex-row" style="justify-content:space-between;align-items:flex-start;">
        <view style="flex:1;">
          <view style="font-size:28rpx;font-weight:900;color:#F0B429;letter-spacing:2rpx;">有名额等你！</view>
          <view class="text-muted" style="font-size:24rpx;margin-top:6rpx;">
            <text wx:if="{{timeLeftMs > 0}}">请在 {{timeLeftStr}} 内确认，超时自动跳过</text>
            <text wx:else>确认窗口已过期</text>
          </view>
        </view>
        <view wx:if="{{timeLeftMs > 0}}" style="font-size:52rpx;font-weight:900;color:#F0B429;">{{timeLeftStr}}</view>
      </view>
      <view wx:if="{{timeLeftMs > 0}}" class="flex-row" style="gap:16rpx;margin-top:24rpx;">
        <button class="action-btn-ghost" bindtap="withdraw" disabled="{{busy}}">放弃</button>
        <button class="action-btn-teal" bindtap="confirmSpot" disabled="{{busy}}">确认报名</button>
      </view>
    </view>

    <!-- confirmed -->
    <view wx:elif="{{actionState === 'confirmed'}}" class="action-card action-confirmed">
      <view class="flex-row" style="justify-content:space-between;align-items:center;">
        <view style="flex-shrink:0;margin-right:16rpx;">
          <view style="font-size:28rpx;font-weight:900;color:#00C9A7;letter-spacing:2rpx;white-space:nowrap;">已报名</view>
          <view class="text-muted" style="font-size:24rpx;margin-top:6rpx;white-space:nowrap;">
            第 {{myRoster}} 位<text wx:if="{{myReg.team && showTeams}}"> · Team {{myReg.team}}</text>
          </view>
        </view>
        <view class="flex-row" style="flex:1;min-width:0;justify-content:flex-end;gap:12rpx;">
          <button wx:if="{{canBringFriend}}" class="inline-btn" style="flex:none;" bindtap="openFriendModal" disabled="{{busy}}">+带朋友</button>
          <button wx:if="{{match.status === 'registration_r1' || match.status === 'registration_r2' || match.status === 'ready'}}"
            class="inline-btn" style="flex:none;" bindtap="excuse" disabled="{{busy}}">请假</button>
        </view>
      </view>
    </view>

    <!-- waitlist -->
    <view wx:elif="{{actionState === 'waitlist'}}" class="action-card">
      <view class="flex-row" style="justify-content:space-between;align-items:center;">
        <view style="flex-shrink:0;margin-right:16rpx;">
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;white-space:nowrap;">候补</view>
          <view class="text-muted" style="font-size:24rpx;margin-top:6rpx;white-space:nowrap;">当前第 {{myWaitRank}} 顺位</view>
        </view>
        <button class="inline-btn-danger" style="flex:none;" bindtap="withdraw" disabled="{{busy}}">退出</button>
      </view>
    </view>

    <!-- excused -->
    <view wx:elif="{{actionState === 'excused'}}" class="action-card">
      <view class="flex-row" style="justify-content:space-between;align-items:center;">
        <view>
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">已请假</view>
          <view class="text-muted" style="font-size:24rpx;margin-top:6rpx;">可随时重新报名</view>
        </view>
        <button class="inline-btn" bindtap="openAgreementModal">重新报名</button>
      </view>
    </view>

    <!-- canRegister -->
    <button wx:elif="{{actionState === 'canRegister'}}" class="btn-primary" bindtap="openAgreementModal" disabled="{{busy}}">
      报名参加 — 还剩 {{slotsLeft}} 个名额
    </button>

    <!-- canWaitlist -->
    <button wx:elif="{{actionState === 'canWaitlist'}}" class="btn-waitlist" bindtap="openWaitlistModal" disabled="{{busy}}">
      {{waitlistBtnText}}
    </button>

    <!-- r1Blocked -->
    <view wx:elif="{{actionState === 'r1Blocked'}}" class="action-card action-neutral">
      <view style="font-size:28rpx;font-weight:700;">R1 阶段仅限年卡会员</view>
      <view class="text-muted" style="font-size:24rpx;margin-top:8rpx;">R2 开放后所有成员均可报名</view>
    </view>

    <!-- banned -->
    <view wx:elif="{{actionState === 'banned'}}" class="action-card action-cancelled">
      <view style="font-size:28rpx;font-weight:700;color:#E53E3E;">禁赛中，暂无法报名</view>
      <view class="text-muted" style="font-size:24rpx;margin-top:8rpx;">还剩 {{banLeft}} 场解禁，如有疑问请联系管理员</view>
    </view>

    <!-- needProfile (new visitor, not onboarded yet) -->
    <button wx:elif="{{actionState === 'needProfile'}}" class="btn-primary" bindtap="goOnboard">
      完善资料，立即报名 →
    </button>

    <!-- needMembership (onboarded but unvetted) -->
    <view wx:elif="{{actionState === 'needMembership'}}" class="action-card action-neutral">
      <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">报名需要会员身份</view>
      <view class="text-muted" style="font-size:24rpx;margin-top:8rpx;line-height:1.7;">
        新朋友请先在群内联系管理员并完成缴费，然后到「我的」页申请次卡（填写真实姓名和缴费备注），管理员核对后批准即可报名。
      </view>
      <button class="inline-btn" style="margin-top:16rpx;" bindtap="goApplyMembership">去申请会员 →</button>
    </view>

    <!-- closed -->
    <view wx:elif="{{actionState === 'closed'}}" class="action-card action-neutral">
      <view class="text-muted">报名已关闭</view>
    </view>

    <!-- Captains/admin: kick off drafting -->
    <button wx:if="{{canStartDraft}}" class="btn-waitlist" style="margin-bottom:16rpx;" bindtap="startDraft" disabled="{{busy}}">
      🚀 开始选人
    </button>

    <!-- ── Roster ──────────────────────────────────────────────────────── -->
    <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">
      名单 <text style="color:#00C9A7;">{{confirmedCount}}/{{match.maxPlayers}}</text>
    </view>

    <!-- Position filter tabs -->
    <scroll-view wx:if="{{confirmedCount > 0}}" scroll-x style="white-space:nowrap;margin-bottom:16rpx;">
      <view
        wx:for="{{posGroups}}"
        wx:key="key"
        class="pos-filter-btn {{posFilter === item.key ? 'active' : ''}}"
        style="display:inline-block;"
        bindtap="setPosFilter"
        data-key="{{item.key}}">
        {{item.label}}
      </view>
    </scroll-view>

    <view wx:if="{{confirmedCount === 0}}" class="text-muted" style="font-size:28rpx;margin-bottom:24rpx;">暂无人报名</view>

    <view wx:else class="card" style="padding-bottom:8rpx;">
      <view wx:for="{{filteredRoster}}" wx:key="uid" class="player-row">
        <view style="width:40rpx;text-align:center;font-size:22rpx;font-weight:900;color:#3A4E63;flex-shrink:0;">{{index + 1}}</view>
        <view style="flex:1;margin-left:16rpx;">
          <view style="font-size:28rpx;font-weight:600;color:#e8f0eb;">
            {{item.displayName}}<text wx:if="{{item.isFriend}}" style="font-size:22rpx;color:#3A4E63;font-weight:400;"> · {{item.friendOf}} 带</text>
          </view>
          <view wx:if="{{item.preferredPositions.length > 0}}" style="display:flex;flex-direction:row;gap:8rpx;margin-top:4rpx;flex-wrap:wrap;">
            <view wx:for="{{item.preferredPositions}}" wx:key="*this" wx:for-item="pos" wx:for-index="pi"
              class="pos-chip {{pi === 0 ? 'pos-chip-primary' : 'pos-chip-secondary'}}">{{pos}}</view>
          </view>
        </view>
        <view wx:if="{{item.isCaptainA}}" class="badge badge-team-a" style="margin-left:8rpx;">队长A</view>
        <view wx:elif="{{item.isCaptainB}}" class="badge badge-team-b" style="margin-left:8rpx;">队长B</view>
        <view wx:elif="{{item.teamLabel}}" class="badge {{item.teamLabel === 'A' ? 'badge-team-a' : 'badge-team-b'}}" style="margin-left:8rpx;">{{item.teamLabel}}</view>
        <view wx:if="{{item.status === 'promoted'}}" class="badge badge-gold" style="margin-left:8rpx;">待确认</view>
        <view wx:if="{{item.canRemove && match.status !== 'completed' && match.status !== 'cancelled'}}"
          class="pick-tap pick-tap-off" style="margin-left:8rpx;"
          catchtap="removeFriend" data-uid="{{item.uid}}" data-name="{{item.displayName}}">移除</view>
      </view>
      <view wx:if="{{filteredRoster.length === 0}}" class="text-muted" style="font-size:26rpx;padding:16rpx 0;">该位置暂无人</view>
    </view>

    <!-- ── Waitlist (order = promotion priority) ─────────────────────── -->
    <view wx:if="{{waitlistCount > 0}}" style="margin-top:8rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">候补 ({{waitlistCount}}) · 按递补顺序</view>
      <view class="card" style="padding-bottom:8rpx;">
        <view wx:for="{{waitlistList}}" wx:key="uid" class="player-row">
          <view style="width:40rpx;text-align:center;font-size:22rpx;font-weight:900;color:#3A4E63;flex-shrink:0;">#{{index + 1}}</view>
          <view style="flex:1;margin-left:16rpx;font-size:28rpx;color:#7A8FA6;">
            {{item.displayName}}
            <text wx:if="{{item.isFriend}}" style="font-size:22rpx;color:#3A4E63;"> · {{item.friendOf}} 带</text>
          </view>
          <view wx:if="{{item.tierTag}}" class="badge badge-grey" style="margin-right:8rpx;">{{item.tierTag}}</view>
          <view wx:if="{{item.canRemove}}" class="pick-tap pick-tap-off" style="margin-right:8rpx;"
            bindtap="removeFriend" data-uid="{{item.uid}}" data-name="{{item.displayName}}">移除</view>
          <view wx:if="{{isAdmin}}" class="pick-tap pick-tap-a"
            bindtap="bumpWait" data-uid="{{item.uid}}" data-name="{{item.displayName}}">↑ 进名单</view>
        </view>
      </view>
    </view>

    <!-- ── Excused ────────────────────────────────────────────────────── -->
    <view wx:if="{{excusedList.length > 0}}" style="margin-top:8rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">请假 ({{excusedList.length}})</view>
      <view class="card" style="padding-bottom:8rpx;opacity:0.6;">
        <view wx:for="{{excusedList}}" wx:key="uid" class="player-row">
          <view style="flex:1;font-size:28rpx;color:#7A8FA6;">{{item.displayName}}</view>
        </view>
      </view>
    </view>

    <!-- ── Admin: captain pickers ────────────────────────────────────── -->
    <view wx:if="{{showAdminCaptain}}" class="card" style="margin-top:8rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:20rpx;">队长设置</view>
      <view style="margin-bottom:20rpx;">
        <view class="text-muted" style="font-size:24rpx;margin-bottom:8rpx;">队长 A</view>
        <picker range="{{confirmedList}}" range-key="displayName" value="{{captainAIndex}}"
          bindchange="setCaptain" data-slot="captainA">
          <view class="picker-row">{{captainAName || '— 未设置 —'}}</view>
        </picker>
      </view>
      <view>
        <view class="text-muted" style="font-size:24rpx;margin-bottom:8rpx;">队长 B</view>
        <picker range="{{confirmedList}}" range-key="displayName" value="{{captainBIndex}}"
          bindchange="setCaptain" data-slot="captainB">
          <view class="picker-row">{{captainBName || '— 未设置 —'}}</view>
        </picker>
      </view>
    </view>

    <!-- ── Draft: team assignment ─────────────────────────────────────── -->
    <view wx:if="{{showDraft}}" style="margin-top:8rpx;">
      <view class="flex-row" style="justify-content:space-between;align-items:baseline;margin-bottom:16rpx;">
        <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;">选人</view>
        <view wx:if="{{draftTurnLabel}}" style="font-size:24rpx;font-weight:700;color:#F0B429;">
          {{draftTurnLabel}}
        </view>
      </view>

      <view wx:if="{{unassignedList.length > 0}}" class="card" style="padding-bottom:8rpx;">
        <view class="text-muted" style="font-size:24rpx;margin-bottom:12rpx;">待分配 · {{unassignedList.length}} 人</view>
        <view wx:for="{{unassignedList}}" wx:key="uid" class="player-row draft-row">
          <view class="draft-player-info">
            <view class="draft-player-name">{{item.displayName}}</view>
            <view wx:if="{{item.preferredPositions[0]}}" class="draft-player-pos">{{item.preferredPositions[0]}}</view>
          </view>
          <view class="draft-actions">
            <view wx:if="{{captainPickerTeam}}"
              class="pick-tap pick-tap-{{captainPickerTeam === 'A' ? 'a' : 'b'}}"
              bindtap="captainPick" data-uid="{{item.uid}}">选 → {{captainPickerTeam}}</view>
            <block wx:elif="{{isAdmin}}">
              <view class="pick-tap pick-tap-a" bindtap="assignTeam" data-uid="{{item.uid}}" data-team="A">→ A</view>
              <view class="pick-tap pick-tap-b" bindtap="assignTeam" data-uid="{{item.uid}}" data-team="B">→ B</view>
            </block>
          </view>
        </view>
      </view>
      <view wx:else class="text-muted" style="font-size:28rpx;margin-bottom:16rpx;">所有球员已分配完毕</view>

      <view style="display:flex;flex-direction:row;gap:16rpx;margin-top:16rpx;">
        <view class="team-box team-box-a" style="flex:1;">
          <view style="font-size:22rpx;font-weight:900;color:#3B82F6;margin-bottom:12rpx;">A队 · {{teamAList.length}} 人</view>
          <view wx:for="{{teamAList}}" wx:key="uid" style="padding:4rpx 0;font-size:26rpx;color:#e8f0eb;">{{item.displayName}}</view>
        </view>
        <view class="team-box team-box-b" style="flex:1;">
          <view style="font-size:22rpx;font-weight:900;color:#EF4444;margin-bottom:12rpx;">B队 · {{teamBList.length}} 人</view>
          <view wx:for="{{teamBList}}" wx:key="uid" style="padding:4rpx 0;font-size:26rpx;color:#e8f0eb;">{{item.displayName}}</view>
        </view>
      </view>
    </view>

    <!-- ── Admin: score editor ────────────────────────────────────────── -->
    <view wx:if="{{showScoreEditor}}" class="card" style="margin-top:8rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:20rpx;">比分记录</view>
      <view class="flex-row" style="align-items:center;gap:16rpx;">
        <view style="flex:1;text-align:center;">
          <view style="font-size:22rpx;font-weight:900;color:#3B82F6;margin-bottom:8rpx;">A队</view>
          <input class="form-input" type="number" value="{{scoreAInput}}" bindinput="onScoreAInput"
            style="text-align:center;" placeholder="-" adjust-position="{{false}}"/>
        </view>
        <view style="font-size:36rpx;font-weight:900;color:#7A8FA6;margin-top:30rpx;">:</view>
        <view style="flex:1;text-align:center;">
          <view style="font-size:22rpx;font-weight:900;color:#EF4444;margin-bottom:8rpx;">B队</view>
          <input class="form-input" type="number" value="{{scoreBInput}}" bindinput="onScoreBInput"
            style="text-align:center;" placeholder="-" adjust-position="{{false}}"/>
        </view>
        <button class="inline-btn" style="margin-top:30rpx;" bindtap="saveScore" disabled="{{busy}}">保存</button>
      </view>
    </view>

    <!-- ── Admin: goals / assists ─────────────────────────────────────── -->
    <view wx:if="{{showBehaviorTags}}" style="margin-top:8rpx;">
      <view class="flex-row" style="justify-content:space-between;align-items:center;margin-bottom:16rpx;">
        <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;">进球 / 助攻</view>
        <view wx:if="{{statsDirty}}" class="pick-tap pick-tap-a" bindtap="saveStats">{{busy ? '保存中...' : '保存修改'}}</view>
      </view>
      <view class="card" style="padding-bottom:8rpx;">
        <view wx:for="{{confirmedList}}" wx:key="uid" class="player-row draft-row">
          <view class="draft-player-name" style="flex:1;">{{item.displayName}}</view>
          <view class="draft-actions" style="align-items:center;gap:8rpx;">
            <view class="pick-tap pick-tap-off" bindtap="incStat" data-index="{{index}}" data-field="goals" data-delta="-1">−</view>
            <view style="font-size:24rpx;color:#e8f0eb;min-width:64rpx;text-align:center;">⚽ {{item.goals}}</view>
            <view class="pick-tap pick-tap-off" bindtap="incStat" data-index="{{index}}" data-field="goals" data-delta="1">+</view>
            <view class="pick-tap pick-tap-off" style="margin-left:12rpx;" bindtap="incStat" data-index="{{index}}" data-field="assists" data-delta="-1">−</view>
            <view style="font-size:24rpx;color:#e8f0eb;min-width:64rpx;text-align:center;">🅰️ {{item.assists}}</view>
            <view class="pick-tap pick-tap-off" bindtap="incStat" data-index="{{index}}" data-field="assists" data-delta="1">+</view>
          </view>
        </view>
        <view wx:if="{{statsDirty}}" class="text-muted" style="font-size:22rpx;padding:12rpx 0;">有未保存的修改，记得点右上角「保存修改」</view>
      </view>
    </view>

    <!-- ── Admin: behavior tags ───────────────────────────────────────── -->
    <view wx:if="{{showBehaviorTags}}" style="margin-top:8rpx;">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">行为记录</view>
      <view class="card" style="padding-bottom:8rpx;">
        <view wx:for="{{confirmedList}}" wx:key="uid" class="player-row draft-row">
          <view class="draft-player-name" style="flex:1;">{{item.displayName}}</view>
          <view class="draft-actions">
            <view class="pick-tap {{item.isLate ? 'pick-tap-late-on' : 'pick-tap-off'}}"
              bindtap="toggleTag" data-uid="{{item.uid}}" data-tag="late">迟到</view>
            <view class="pick-tap {{item.isDangerous ? 'pick-tap-danger-on' : 'pick-tap-off'}}"
              bindtap="toggleTag" data-uid="{{item.uid}}" data-tag="dangerous">危险</view>
            <view class="pick-tap {{item.isAbsent ? 'pick-tap-danger-on' : 'pick-tap-off'}}"
              bindtap="toggleTag" data-uid="{{item.uid}}" data-tag="absent">缺席</view>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- ── Agreement modal ───────────────────────────────────────────────── -->
  <view wx:if="{{showAgreementModal}}" class="modal-overlay" bindtap="closeAgreementModal">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-handle"></view>
      <view style="font-size:36rpx;font-weight:900;color:#e8f0eb;margin-bottom:20rpx;">报名须知</view>
      <scroll-view scroll-y style="max-height:320rpx;margin-bottom:32rpx;">
        <view style="font-size:26rpx;line-height:1.8;color:#7A8FA6;white-space:pre-wrap;">{{agreementText}}</view>
      </scroll-view>
      <view class="flex-row" style="gap:16rpx;">
        <button class="modal-btn-ghost" bindtap="closeAgreementModal">取消</button>
        <button class="modal-btn-teal" bindtap="register" disabled="{{busy}}">{{busy ? '处理中...' : '同意并报名'}}</button>
      </view>
    </view>
  </view>

  <!-- ── Waitlist modal ────────────────────────────────────────────────── -->
  <view wx:if="{{showWaitlistModal}}" class="modal-overlay" bindtap="closeWaitlistModal">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-handle"></view>
      <view style="font-size:36rpx;font-weight:900;color:#e8f0eb;margin-bottom:12rpx;">加入候补</view>
      <view class="text-muted" style="font-size:26rpx;margin-bottom:24rpx;line-height:1.7;">
        名额已满，你将排在 <text style="color:#e8f0eb;font-weight:700;">候补 #{{waitlistCount + 1}}</text>，有人退出时按顺序通知。
      </view>
      <view class="flex-row" style="gap:20rpx;margin-bottom:16rpx;" bindtap="toggleAutoAccept">
        <view class="toggle-track {{autoAccept ? 'toggle-on' : 'toggle-off'}}">
          <view class="toggle-thumb {{autoAccept ? 'toggle-thumb-on' : 'toggle-thumb-off'}}"></view>
        </view>
        <view style="flex:1;">
          <view style="font-size:28rpx;font-weight:700;color:#e8f0eb;">自动接受晋升</view>
          <view class="text-muted" style="font-size:24rpx;">轮到你时直接确认，无需手动操作</view>
        </view>
      </view>
      <view wx:if="{{!autoAccept}}" class="waitlist-note">
        晋升后有 30 分钟窗口，超时将跳至下一位候补。
      </view>
      <view class="flex-row" style="gap:16rpx;">
        <button class="modal-btn-ghost" bindtap="closeWaitlistModal">取消</button>
        <button class="modal-btn-teal" bindtap="registerWaitlist" disabled="{{busy}}">{{busy ? '处理中...' : '加入候补'}}</button>
      </view>
    </view>
  </view>

  <!-- ── Bring-a-friend modal ──────────────────────────────────────────── -->
  <view wx:if="{{showFriendModal}}" class="modal-overlay" bindtap="closeFriendModal">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-handle"></view>
      <view style="font-size:36rpx;font-weight:900;color:#e8f0eb;margin-bottom:12rpx;">帮朋友报名候补</view>
      <view class="text-muted" style="font-size:26rpx;margin-bottom:24rpx;line-height:1.7;">
        朋友将加入候补，优先级在年卡本人之后、次卡之前，有空位时自动递补（每人最多带 2 位）。
      </view>
      <input class="friend-input" placeholder="朋友称呼，例：小李（王强朋友）" value="{{friendName}}"
        bindinput="onFriendNameInput" adjust-position="{{false}}"/>
      <view class="text-muted" style="font-size:22rpx;margin:24rpx 0 12rpx;">擅长位置（至少 1 个，最多 3 个）</view>
      <view style="display:flex;flex-direction:row;flex-wrap:wrap;">
        <view wx:for="{{allPositions}}" wx:key="*this"
          class="pos-filter-btn {{friendPosMap[item] ? 'active' : ''}}"
          style="margin-bottom:12rpx;"
          bindtap="toggleFriendPos" data-pos="{{item}}">{{item}}</view>
      </view>
      <view class="flex-row" style="gap:16rpx;margin-top:32rpx;">
        <button class="modal-btn-ghost" bindtap="closeFriendModal">取消</button>
        <button class="modal-btn-teal" bindtap="addFriend" disabled="{{busy}}">{{busy ? '处理中...' : '加入候补'}}</button>
      </view>
    </view>
  </view>

  <!-- ── Rules modal ───────────────────────────────────────────────────── -->
  <view wx:if="{{showRulesModal}}" class="modal-overlay" bindtap="closeRulesModal">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-handle"></view>
      <view style="font-size:36rpx;font-weight:900;color:#e8f0eb;margin-bottom:20rpx;">报名规则</view>
      <scroll-view scroll-y style="max-height:640rpx;margin-bottom:32rpx;">
        <view class="rule-line"><text class="rule-num">1</text>R1 年卡轮：比赛发布后先开放年卡会员报名；次卡可先加入候补排队。</view>
        <view class="rule-line"><text class="rule-num">2</text>R2 开放轮：开球前 8 小时自动开放，年卡、次卡会员均可报名。新朋友需先联系管理员缴费开通次卡（可在「我的」页提交申请）。</view>
        <view class="rule-line"><text class="rule-num">3</text>名单锁定：开球前 1 小时锁定，不再接受报名和候补；名额满员时仍可加入候补等待递补。</view>
        <view class="rule-line"><text class="rule-num">4</text>候补优先级：年卡本人 &gt; 年卡带的朋友 &gt; 次卡；同级按加入候补先后。有空位时自动按此顺序递补，不可插队。</view>
        <view class="rule-line"><text class="rule-num">5</text>带朋友：年卡会员完成自己报名后，可帮朋友加入候补，每人最多 2 位；朋友递补成功会通知带人者。带人者退出或请假后，朋友转为普通候补（按次卡优先级重新排队）。</view>
        <view class="rule-line"><text class="rule-num">6</text>递补确认：关闭「自动接受」的候补，递补时需在限时内确认，超时排回队尾。</view>
        <view class="rule-line"><text class="rule-num">7</text>请假 / 退出：开赛前可随时操作，空出的名额自动递补给候补。</view>
        <view class="rule-line"><text class="rule-num">8</text>缺席：报名后无故缺席将被禁赛 4 场。</view>
        <view class="rule-line"><text class="rule-num">9</text>管理员可视情况直接调整名单。</view>
      </scroll-view>
      <button class="modal-btn-teal" bindtap="closeRulesModal">知道了</button>
    </view>
  </view>

  <canvas type="2d" id="share-canvas" style="position:fixed;left:-9999px;top:-9999px;width:500px;height:400px;"/>

</view>
