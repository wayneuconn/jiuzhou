.match-card {
  background: #0F1923;
  border: 1rpx solid #1E2D3D;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.match-card-past {
  opacity: 0.6;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-teal { background: #00C9A7; }
.dot-pulse { background: #F0B429; }
.dot-red   { background: rgba(229,62,62,0.5); }
.dot-grey  { background: #1E2D3D; }
