<view class="container">
  <view wx:if="{{loading}}" style="text-align:center;padding:80rpx 0;">
    <view class="text-muted">加载中...</view>
  </view>

  <block wx:else>
    <view style="font-size:48rpx;font-weight:900;margin-bottom:32rpx;">比赛</view>

    <!-- Upcoming -->
    <view wx:if="{{upcoming.length > 0}}">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">即将进行</view>
      <view wx:for="{{upcoming}}" wx:key="id" class="match-card" style="{{isAdmin ? 'padding-bottom:0' : ''}}">
        <view bindtap="goToDetail" data-id="{{item.id}}">
          <view class="flex-row" style="justify-content:space-between;align-items:flex-start;">
            <view style="flex:1;">
              <view class="flex-row" style="gap:12rpx;margin-bottom:8rpx;">
                <view class="status-dot {{item.statusDot}}"></view>
                <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:2rpx;text-transform:uppercase;">{{item.statusLabel}}</view>
              </view>
              <view style="font-size:30rpx;font-weight:700;color:#e8f0eb;">{{item.dateStr}}</view>
              <view class="text-muted" style="font-size:26rpx;margin-top:4rpx;">{{item.location}}</view>
            </view>
            <view wx:if="{{item.isOpen}}" class="badge badge-teal" style="flex-shrink:0;margin-left:16rpx;">报名 →</view>
            <view wx:elif="{{item.status !== 'draft'}}" class="text-muted" style="font-size:36rpx;margin-left:16rpx;">→</view>
          </view>
        </view>
        <!-- Admin phase controls — only visible to admins -->
        <view wx:if="{{isAdmin}}" class="flex-row" style="gap:12rpx;margin-top:16rpx;padding:16rpx 0;border-top:1rpx solid #1E2D3D;">
          <button
            wx:if="{{item.canAdvance}}"
            size="mini"
            class="btn-primary"
            style="flex:1;font-size:24rpx;"
            catchtap="advanceStatus"
            data-id="{{item.id}}"
            data-next="{{item.nextStatus}}">
            → {{item.nextStatusLabel}}
          </button>
          <button
            size="mini"
            class="btn-ghost"
            style="font-size:24rpx;"
            catchtap="cancelMatch"
            data-id="{{item.id}}">
            取消
          </button>
        </view>
      </view>
    </view>

    <!-- Empty state -->
    <view wx:if="{{upcoming.length === 0 && past.length === 0}}" class="card" style="text-align:center;padding:80rpx 0;">
      <view style="font-size:80rpx;">⚽</view>
      <view class="text-muted" style="margin-top:16rpx;">暂无比赛安排</view>
    </view>

    <!-- Past -->
    <view wx:if="{{past.length > 0}}" style="margin-top:{{upcoming.length > 0 ? '32rpx' : '0'}};">
      <view style="font-size:22rpx;font-weight:900;color:#7A8FA6;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:16rpx;">往期</view>
      <view
        wx:for="{{past}}"
        wx:key="id"
        class="match-card match-card-past"
        bindtap="goToDetail"
        data-id="{{item.id}}">
        <view class="flex-row" style="justify-content:space-between;align-items:center;">
          <view>
            <view style="font-size:30rpx;font-weight:700;color:#7A8FA6;">{{item.dateStr}}</view>
            <view class="text-muted" style="font-size:26rpx;margin-top:4rpx;">{{item.location}}</view>
          </view>
          <view wx:if="{{item.status === 'cancelled'}}" class="badge badge-red" style="flex-shrink:0;">已取消</view>
          <view wx:elif="{{item.scoreA !== null && item.scoreA !== undefined}}"
            style="font-size:34rpx;font-weight:900;color:#e8f0eb;flex-shrink:0;">{{item.scoreA}} : {{item.scoreB}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
