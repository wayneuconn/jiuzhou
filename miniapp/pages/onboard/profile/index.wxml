<view class="container">
  <view style="padding:48rpx 0 32rpx;text-align:center;">
    <view style="font-size:44rpx;font-weight:900;color:#e8f0eb;">完善资料</view>
    <view class="text-muted" style="margin-top:12rpx;font-size:28rpx;">让队友认识你</view>
  </view>

  <view class="card">
    <view class="field-label">昵称</view>
    <input
      class="field-input"
      placeholder="输入你在队里的名字"
      placeholder-style="color:#3A4E63"
      value="{{displayName}}"
      bindinput="onNameInput"
      maxlength="20" />
  </view>

  <view class="card" style="margin-top:16rpx;">
    <view class="field-label">擅长位置 <text style="color:#7A8FA6;font-weight:400;">（至少选 1 个）</text></view>
    <view class="position-row">
      <view
        wx:for="{{POSITIONS}}"
        wx:key="*this"
        class="position-chip {{selectedMap[item] ? 'selected' : ''}}"
        bindtap="togglePosition"
        data-pos="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <button
    class="btn-primary"
    style="margin-top:32rpx;"
    bindtap="onSubmit"
    loading="{{loading}}"
    disabled="{{loading || !displayName}}">
    完成，进入球队
  </button>

  <!-- Review requirement: a prominent way out. This page can be reached with
       an empty navigation stack, so a native back arrow isn't guaranteed. -->
  <button class="btn-ghost" style="margin-top:20rpx;" bindtap="skipSetup">以后再说，先逛逛</button>
  <view class="text-muted" style="font-size:22rpx;text-align:center;margin-top:16rpx;line-height:1.6;">
    不填也能浏览比赛、公告和榜单；报名时再填就行
  </view>
</view>
