.field-label {
  font-size: 22rpx;
  font-weight: 900;
  color: #7A8FA6;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.field-input {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8f0eb;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #1E2D3D;
  width: 100%;
  background: transparent;
}

.position-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.position-chip {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: transparent;
  font-size: 24rpx;
  font-weight: 700;
  color: #7A8FA6;
  border: 1rpx solid #1E2D3D;
}

.position-chip.selected {
  background: #00C9A7;
  color: #0D1117;
  border-color: #00C9A7;
  font-weight: 900;
}
