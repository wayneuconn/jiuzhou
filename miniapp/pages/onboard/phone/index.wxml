<view class="container" style="padding-top:100rpx;">

  <!-- Step 1: enter phone -->
  <block wx:if="{{step === 'phone'}}">
    <view style="font-size:48rpx;font-weight:900;text-align:center;margin-bottom:16rpx;">绑定手机号</view>
    <view class="text-muted" style="text-align:center;font-size:26rpx;margin-bottom:64rpx;">用于接收比赛通知</view>

    <view style="margin-bottom:24rpx;">
      <view class="text-muted" style="font-size:22rpx;margin-bottom:10rpx;">手机号</view>
      <view class="phone-input-wrap">
        <text style="color:#7A8FA6;margin-right:8rpx;">+86</text>
        <input
          class="phone-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-style="color:#4A5568"
          value="{{phone}}"
          bindinput="onPhoneInput"/>
      </view>
    </view>

    <button
      class="btn-primary"
      bindtap="sendCode"
      loading="{{sending}}"
      disabled="{{sending || phone.length < 11}}">
      发送验证码
    </button>
  </block>

  <!-- Step 2: enter OTP -->
  <block wx:elif="{{step === 'code'}}">
    <view style="font-size:48rpx;font-weight:900;text-align:center;margin-bottom:16rpx;">输入验证码</view>
    <view class="text-muted" style="text-align:center;font-size:26rpx;margin-bottom:8rpx;">已发送至 +86 {{phone}}</view>
    <view class="text-muted" style="text-align:center;font-size:22rpx;margin-bottom:64rpx;">验证码10分钟内有效</view>

    <view style="margin-bottom:24rpx;">
      <input
        class="code-input"
        type="number"
        maxlength="6"
        placeholder="6位验证码"
        placeholder-style="color:#4A5568;text-align:center"
        value="{{code}}"
        bindinput="onCodeInput"
        focus="{{true}}"/>
    </view>

    <button
      class="btn-primary"
      bindtap="verify"
      loading="{{verifying}}"
      disabled="{{verifying || code.length < 6}}">
      验证
    </button>

    <view style="text-align:center;margin-top:32rpx;">
      <text
        class="text-muted"
        style="font-size:26rpx;"
        bindtap="{{countdown > 0 ? '' : 'sendCode'}}">
        {{countdown > 0 ? '重新发送 (' + countdown + 's)' : '重新发送'}}
      </text>
    </view>
    <view style="text-align:center;margin-top:20rpx;">
      <text class="text-muted" style="font-size:24rpx;" bindtap="backToPhone">← 修改手机号</text>
    </view>
  </block>

  <!-- Skip -->
  <view style="text-align:center;margin-top:60rpx;">
    <text class="text-muted" style="font-size:26rpx;" bindtap="skipForNow">暂时跳过 →</text>
  </view>

</view>
